{
	"compatibility_date": "2026-03-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"name": "vws-starter-2026",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "vws_starter_2026_db",
			"database_name": "vws-starter-2026-db",
			"database_id": "51b4a7ea-be86-4ec6-842a-8510ce976511",
			"remote": true,
			"migrations_dir": "../../migrations"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "vws-starter-2026-media",
			"binding": "vws_starter_2026_media",
			"remote": true
		}
	]
}