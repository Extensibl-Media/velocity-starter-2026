{
	"compatibility_date": "2026-03-17",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"name": "vws-starter-2026",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// EmDash content DB. `database_id` is a placeholder for local (miniflare) dev;
	// replace with the real id from `wrangler d1 create` before deploying (Phase 6).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vws-starter-2026-db",
			"database_id": "local-dev-placeholder"
		}
	],
	// EmDash media storage.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "vws-starter-2026-media"
		}
	]
}
