---
// Blog post — live from EmDash (D1) under SSR. Body = Portable Text rendered
// inside Starwind's <Prose> (the `prose` class alone has no styles — Tailwind
// Typography isn't installed; Prose carries its own sw-prose CSS). Meta tags
// come from EmDash's native SEO panel (getSeoMeta).
import BlogLayout from "@/layouts/BlogLayout.astro";
import { PortableText, WidgetArea } from "emdash/ui";
import Prose from "@/components/starwind/prose/Prose.astro";
import { getSeoMeta } from "emdash/seo";
import { getPost } from "@/lib/content";
import siteConfig from "@/config/site.config";

const slug = Astro.params.slug!;
const post = await getPost(slug);
if (!post) return Astro.rewrite("/404");

const meta = getSeoMeta(post as any, {
  siteUrl: Astro.site?.href,
  path: Astro.url.pathname,
  defaultOgImage: siteConfig.ogImage ? new URL(siteConfig.ogImage, Astro.site).toString() : undefined,
});
---

<BlogLayout
  page={post}
  title={meta.title || post.data.title}
  description={meta.description ?? post.data.description}
  noindex={!!meta.robots}
  image={meta.ogImage ?? undefined}
  canonical={meta.canonical ?? undefined}
  article={{ publishedTime: post.data.date, authors: [post.data.author] }}
>
  <article class="post-article">
    <Prose>
      <h1>{post.data.title}</h1>
      <PortableText value={post.data.body} />
    </Prose>
  </article>
  <WidgetArea name="post-footer" class="widget-area post-footer" />
</BlogLayout>
