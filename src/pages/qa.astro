---
/**
 * /qa — Theme QA harness (noindex, dev/QA only).
 *
 * Part A: token swatches rendered in all 6 themes — the fastest way to spot an
 *         invisible text token, washed button, unreadable badge, or low-contrast card.
 * Part B: a representative, token-stressing section from each major group,
 *         rendered across every theme — catches contrast AND alignment issues in situ.
 *
 * Chrome (headers/footers) is covered by /components/chrome. Add a type to REPS
 * to include another section in the sweep.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ThemeSwatches from "@/components/qa/ThemeSwatches.astro";
import { sectionRegistry } from "@/lib/sectionRegistry";
import demo from "@/content/pages/sections.json";

const THEMES = [
  "default",
  "alt",
  "muted",
  "inverse",
  "primary",
  "brand-secondary",
] as const;

// Representative sections that exercise eyebrows, headings, body, accents,
// buttons, cards, stats, forms/inputs, images, and tabular check/cross marks.
const REPS = [
  "hero:badge-row",
  "feature:cards",
  "stats:cards",
  "pricing:tiers",
  "reviews:quote",
  "comparison:us-vs-them",
  "content:image-text",
  "about:values",
  "contact:form",
  "cta:centered",
  "gallery:grid",
];

const sections = demo.sections as Array<{ type: string; data?: unknown }>;
const dataFor = (type: string) => sections.find((s) => s.type === type)?.data;
---

<BaseLayout
  page={{ id: "qa", data: { title: "Theme QA" } }}
  title="Theme QA"
  description="Theme QA harness"
  noindex={true}
>
  <div class="qa-intro">
    <h1>Theme QA Harness</h1>
    <p>
      Every load-bearing token and a representative section from each group,
      rendered across all 6 themes. Scan for: invisible text, washed
      buttons/badges, low-contrast cards, and broken alignment. Chrome lives at
      <a href="/components/chrome">/components/chrome</a>.
    </p>
  </div>

  {/* ── Part A: token swatches per theme ────────────────────────────── */}
  <h2 class="qa-h2">A · Token swatches</h2>
  {
    THEMES.map((theme) => (
      <div class:list={[`theme-${theme}`, "qa-band"]}>
        <div class="qa-band-inner">
          <span class="qa-tag">theme: {theme}</span>
          <ThemeSwatches />
        </div>
      </div>
    ))
  }

  {/* ── Part B: representative sections × themes ─────────────────────── */}
  <h2 class="qa-h2">B · Sections × themes</h2>
  {
    REPS.map((type) => {
      const Component = sectionRegistry[type];
      const data = dataFor(type);
      if (!Component) return null;
      return (
        <div class="qa-group">
          <h3 class="qa-group-label">{type}</h3>
          {THEMES.map((theme) => (
            <div class="qa-render">
              <span class="qa-tag qa-tag-float">{theme}</span>
              <Component theme={theme} data={data} />
            </div>
          ))}
        </div>
      );
    })
  }
</BaseLayout>

<style is:global>
  .qa-intro {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0.5rem;
  }
  .qa-intro h1 {
    font-size: 2rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
  }
  .qa-intro p {
    color: #555;
    line-height: 1.5;
  }
  .qa-h2 {
    max-width: 60rem;
    margin: 2.5rem auto 0;
    padding: 0.5rem 1.5rem;
    font-family: monospace;
    font-size: 1.1rem;
    font-weight: 700;
    border-top: 3px solid #111;
  }
  .qa-band {
    padding: 1.5rem;
  }
  .qa-band-inner {
    max-width: 72rem;
    margin: 0 auto;
  }
  .qa-tag {
    display: inline-block;
    font-family: monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: #111;
    color: #fff;
    padding: 0.15rem 0.55rem;
    border-radius: 0.25rem;
    margin-bottom: 0.9rem;
  }
  .qa-group {
    border-bottom: 5px solid #111;
  }
  .qa-group-label {
    position: sticky;
    top: 0;
    z-index: 40;
    margin: 0;
    padding: 0.4rem 1rem;
    background: #111;
    color: #fff;
    font-family: monospace;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .qa-render {
    position: relative;
  }
  .qa-tag-float {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 30;
    margin: 0;
    opacity: 0.9;
    pointer-events: none;
  }
</style>
