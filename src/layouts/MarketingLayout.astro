---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getResolvedNav } from "@/lib/utils";
import { getAppearance } from "@/lib/content";
import { resolveHeader, resolveFooter } from "@/lib/layoutRegistry";

interface Props {
  page: {
    id: string;
    data: Record<string, any>;
  };
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    authors?: string[];
    tags?: string[];
  };
  noindex?: boolean;
  nofollow?: boolean;
  includeLocalBusinessSchema?: boolean;
  businessType?: string;
  openingHours?: string[];
  areaServed?: string[];
  canonical?: string;
  schemas?: any[];
}

const {
  title,
  description,
  image,
  imageAlt,
  article,
  noindex = false,
  nofollow = false,
  includeLocalBusinessSchema = true,
  businessType = "GeneralContractor",
  openingHours,
  areaServed,
  canonical,
  schemas,
  page,
} = Astro.props;

const navItems = await getResolvedNav();
const appearance = await getAppearance();
const Header = resolveHeader(appearance.headerVariant);
const Footer = resolveFooter(appearance.footerVariant);
---

<BaseLayout
  page={page}
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  article={article}
  noindex={noindex}
  nofollow={nofollow}
  includeLocalBusinessSchema={includeLocalBusinessSchema}
  businessType={businessType}
  openingHours={openingHours}
  areaServed={areaServed}
  canonical={canonical}
  schemas={schemas}
>
  <Header slot="header" navItems={navItems} />
  <slot />
  <Footer slot="footer" />
</BaseLayout>
