---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getResolvedNav } from "@/lib/utils";
import { getAppearance } from "@/lib/content";
import { resolveHeader, resolveFooter } from "@/lib/layoutRegistry";
import { WidgetArea } from "emdash/ui";

interface Props {
  page: {
    id: string;
    data: Record<string, any>;
  };
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    authors?: string[];
    tags?: string[];
  };
  noindex?: boolean;
  nofollow?: boolean;
  includeLocalBusinessSchema?: boolean;
  businessType?: string;
  openingHours?: string[];
  areaServed?: string[];
  /** Override the canonical URL for this post (forwarded to BaseLayout). */
  canonical?: string;
}

const {
  page,
  title,
  description,
  image,
  imageAlt,
  article,
  noindex = false,
  nofollow = false,
  includeLocalBusinessSchema = true,
  businessType = "GeneralContractor",
  openingHours,
  areaServed,
  canonical,
} = Astro.props;

const navItems = await getResolvedNav();
const appearance = await getAppearance();
const Header = resolveHeader(appearance.headerVariant);
const Footer = resolveFooter(appearance.footerVariant);
---

<BaseLayout
  page={page}
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  article={article}
  noindex={noindex}
  nofollow={nofollow}
  includeLocalBusinessSchema={includeLocalBusinessSchema}
  includeBlogSchema={true}
  businessType={businessType}
  openingHours={openingHours}
  areaServed={areaServed}
  canonical={canonical}
>
  <Header slot="header" navItems={navItems} />
  <div class="section-wrapper">
    <div class="section-container blog-shell">
      <div class="blog-main"><slot /></div>
      <aside class="blog-aside">
        <WidgetArea name="blog-sidebar" class="widget-area" />
      </aside>
    </div>
  </div>
  <Footer slot="footer" />
</BaseLayout>
