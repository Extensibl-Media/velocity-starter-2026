---
import { getBusinessData } from "@/lib/utils";
import type { SectionCTA } from "@/types/sections";
import { Button } from "@/components/elements/button";

interface Props {
  theme?: string;
  data?: {
    text?: string;
    cta?: SectionCTA;
    showPhone?: boolean;
    dismissible?: boolean;
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();

const hasContent = !!(data?.text || data?.cta);
const dismissible = data?.dismissible ?? true;
const showPhone = data?.showPhone && !!business.phone;
---

{
  hasContent && (
    <div
      data-sticky-bar
      class:list={["cta-sticky-bar section-wrapper", `theme-${theme}`]}
    >
      <div class="mx-auto max-w-6xl px-4 py-3">
        <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center sm:justify-between gap-sm text-center sm:text-left">
          {data?.text && (
            <span class="theme-text text-sm font-semibold sm:text-base">
              {data.text}
            </span>
          )}

          <div class="flex flex-wrap items-center justify-center gap-sm">
            {data?.cta && (
              <Button variant={data.cta.variant ?? "primary"} href={data.cta.href}>
                {data.cta.label}
              </Button>
            )}

            {showPhone && (
              <a
                href={`tel:${business.phone}`}
                class="theme-text inline-flex items-center gap-xs font-bold no-underline hover:opacity-80 transition-opacity"
              >
                <svg
                  class="w-5 h-5 shrink-0"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                {business.phone}
              </a>
            )}
          </div>

          {dismissible && (
            <button
              type="button"
              data-dismiss
              aria-label="Dismiss"
              class="theme-text absolute right-2 top-2 inline-flex items-center justify-center rounded p-1 opacity-70 hover:opacity-100 transition-opacity sm:static sm:translate-y-0"
            >
              <svg
                class="w-4 h-4 shrink-0"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M18 6 6 18M6 6l12 12" />
              </svg>
            </button>
          )}
        </div>
      </div>
    </div>
  )
}

<style>
  /* The `theme-{theme}` class provides the bg + matched text pair (set the
     section's `theme` to pick the bar color: inverse = dark, primary = brand,
     default = light). Never hardcode a surface here or text can mismatch it. */
  .cta-sticky-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    width: 100%;
    border-top: var(--t-border-width) solid var(--theme-border);
    box-shadow: 0 -4px 24px -6px rgba(0, 0, 0, 0.25);
  }
</style>

<script>
  function initAll() {
    document.querySelectorAll<HTMLElement>("[data-dismiss]").forEach((b) => {
      if (b.dataset.ready) return;
      b.dataset.ready = "1";
      b.addEventListener("click", () => {
        const root = b.closest("[data-sticky-bar],[data-announcement]");
        if (root) (root as HTMLElement).hidden = true;
      });
    });
  }
  initAll();
  document.addEventListener("astro:after-swap", initAll);
</script>
