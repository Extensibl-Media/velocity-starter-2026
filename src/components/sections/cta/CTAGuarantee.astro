---
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

/**
 * cta:guarantee — a risk-reversal CTA. A circular "seal" badge on the left,
 * then the guarantee headline, a checklist of what's promised, and the action
 * button on the right. Removes purchase friction right at the ask.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    sealText?: string;
    bullets?: string[];
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
    ctas?: SectionCTA[];
  };
}

const { theme = "default", data } = Astro.props;

const ctas = (
  data?.ctas?.length ? data.ctas : [data?.cta, data?.secondaryCta].filter(Boolean)
) as SectionCTA[];
const bullets = data?.bullets ?? [];
---

<section class:list={["cta-guarantee section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    <div class="guarantee-card flex flex-col md:flex-row md:items-center gap-xl lg:gap-12">
      {data?.sealText && (
        <div class="seal shrink-0 mx-auto md:mx-0" aria-hidden="true">
          <svg class="seal-icon w-8 h-8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M9 12l2 2 4-4" />
            <path d="M12 3l2.5 1.8 3-.2.9 2.9 2.4 1.8-1 2.9 1 2.9-2.4 1.8-.9 2.9-3-.2L12 21l-2.5-1.8-3 .2-.9-2.9L3.2 15l1-2.9-1-2.9 2.4-1.8.9-2.9 3 .2z" />
          </svg>
          <span class="seal-text">{data.sealText}</span>
        </div>
      )}

      <div class="flex flex-col gap-md flex-1">
        {data?.eyebrow &&
          (data.eyebrow.variant === "badge" ? (
            <Badge class="uppercase tracking-widest text-xs w-fit">{data.eyebrow.text}</Badge>
          ) : (
            <span class="text-sm font-bold uppercase tracking-widest theme-accent">
              {data.eyebrow.text}
            </span>
          ))}

        {data?.heading && (
          <h2 class="theme-heading text-2xl lg:text-3xl font-black m-0 leading-tight">
            {data.heading}
          </h2>
        )}

        {data?.subheading && (
          <p class="theme-text-muted text-lg leading-relaxed m-0">{data.subheading}</p>
        )}

        {bullets.length > 0 && (
          <ul class="flex flex-col gap-xs list-none m-0 p-0">
            {bullets.map((bullet) => (
              <li class="inline-flex items-start gap-xs theme-text font-medium">
                <svg class="w-5 h-5 shrink-0 mt-0.5 theme-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {bullet}
              </li>
            ))}
          </ul>
        )}
      </div>

      {ctas.length > 0 && (
        <div class="flex flex-col gap-sm shrink-0 md:self-center w-full md:w-auto">
          {ctas.map((cta, i) => (
            <Button variant={cta.variant ?? (i === 0 ? "primary" : "outline")} href={cta.href}>
              {cta.label}
            </Button>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .guarantee-card {
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    box-shadow: var(--t-shadow-md);
    padding: 2rem;
  }
  .seal {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 7rem;
    height: 7rem;
    border-radius: 9999px;
    text-align: center;
    color: var(--theme-accent);
    border: 3px solid var(--theme-accent);
    background-color: color-mix(in srgb, var(--theme-accent) 10%, transparent);
  }
  .seal-text {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.1;
    max-width: 5.5rem;
  }
</style>
