---
import { getBusinessData } from "@/lib/utils";
import { getBackgroundImage } from "@/lib/images";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading: string;
    subheading?: string;
    ctas?: SectionCTA[];
    showPhone?: boolean;
    backgroundImage?: {
      src: string;
      alt?: string;
      overlayOpacity?: number;
    };
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();

const bgUrl = await getBackgroundImage(data?.backgroundImage?.src, { width: 2000 });
const hasBackground = !!bgUrl;
const overlayOpacity = (data?.backgroundImage?.overlayOpacity ?? 65) / 100;
---

<section
  class:list={[
    "cta-banner section-wrapper section-py-lg",
    `theme-${theme}`,
    hasBackground ? "has-bg" : "no-bg",
  ]}
  style={hasBackground
    ? `--cta-image: url('${bgUrl}'); --cta-overlay: ${overlayOpacity}`
    : ""}
>
  <div class="section-container relative z-10">
    <div class="flex flex-col items-center text-center gap-lg max-w-3xl mx-auto">
      {
        data?.eyebrow && (
          <div>
            {data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            )}
          </div>
        )
      }

      {
        data?.heading && (
          <h2 class="theme-heading text-3xl lg:text-5xl font-black m-0 leading-tight">
            {data.heading}
          </h2>
        )
      }

      {
        data?.subheading && (
          <p class="theme-text-muted text-lg leading-relaxed m-0">
            {data.subheading}
          </p>
        )
      }

      {/* CTAs */}
      {
        (data?.ctas?.length || data?.showPhone) && (
          <div class="flex flex-wrap items-center justify-center gap-md mt-2">
            {data?.ctas?.map((cta) => (
              <Button variant={cta.variant ?? "secondary"} href={cta.href}>
                {cta.label}
              </Button>
            ))}
            {data?.showPhone && business.phone && (
              <a
                href={`tel:${business.phone}`}
                class="inline-flex items-center gap-xs font-bold text-lg theme-text hover:opacity-80 transition-opacity no-underline"
              >
                <svg
                  class="w-5 h-5 shrink-0"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                {business.phone}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta-banner {
    position: relative;
    overflow: hidden;
  }

  /* Background image */
  .cta-banner.has-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--cta-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Overlay */
  .cta-banner.has-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, var(--cta-overlay, 0.65));
  }

  /* Gradient fallback when no image — uses theme vars */
  .cta-banner.no-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(255, 255, 255, 0.05) 0%,
      transparent 70%
    );
    pointer-events: none;
  }
</style>
