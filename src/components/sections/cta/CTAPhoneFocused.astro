---
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    showPhone?: boolean;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();

const showPhone = data?.showPhone ?? true;
const hasPhone = showPhone && !!business.phone;
const hasContent = !!(data?.heading || data?.subheading || hasPhone || data?.cta);
---

{
  hasContent && (
    <section class:list={["cta-phone-focused section-wrapper section-py-lg", `theme-${theme}`]}>
      <div class="section-container">
        <div class="flex flex-col items-center text-center gap-md max-w-2xl mx-auto">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-primary">
                {data.eyebrow.text}
              </span>
            ))}

          {data?.heading && (
            <h2 class="theme-heading text-2xl lg:text-3xl font-bold m-0 leading-tight">
              {data.heading}
            </h2>
          )}

          {hasPhone && (
            <a
              href={`tel:${business.phone}`}
              class="giant-phone inline-flex items-center gap-sm text-4xl lg:text-5xl font-bold text-primary hover:opacity-80 transition-opacity no-underline"
            >
              <svg
                class="w-8 h-8 lg:w-10 lg:h-10 shrink-0"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              {business.phone}
            </a>
          )}

          {data?.subheading && (
            <p class="theme-text-muted text-lg leading-relaxed m-0">{data.subheading}</p>
          )}

          {data?.cta && (
            <div class="mt-2">
              <Button variant={data.cta.variant ?? "secondary"} href={data.cta.href}>
                {data.cta.label}
              </Button>
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
