---
import type { Eyebrow, StatItem } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

/**
 * stats:icon-grid — one raised card per metric, each led by its own emoji icon
 * in an accent-tinted chip. Icons make each stat scannable and distinct. The
 * icon is authored per stat (data.stats[].icon). No client JS.
 */
interface StatWithIcon extends StatItem {
  icon?: string;
}

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    stats?: StatWithIcon[];
  };
}

const { theme = "default", data } = Astro.props;

const stats = (data?.stats ?? []) as StatWithIcon[];

const count = stats.length;
const gridClass =
  count === 1
    ? "grid-cols-1"
    : count === 2
      ? "grid-cols-1 sm:grid-cols-2"
      : count === 3
        ? "grid-cols-1 sm:grid-cols-3"
        : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4";
---

{
  stats.length > 0 && (
    <section class:list={["stats-icon-grid section-wrapper section-py", `theme-${theme}`]}>
      <div class="section-container">
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-sm mb-12">
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                  {data.eyebrow.text}
                </span>
              ))}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>
            )}
          </div>
        )}

        <div class:list={["grid gap-lg", gridClass]}>
          {stats.map((stat) => (
            <div class="stat-card flex flex-col items-start gap-sm p-6 lg:p-7">
              {stat.icon && (
                <span class="stat-chip flex items-center justify-center w-12 h-12 rounded-full text-2xl leading-none shrink-0">
                  {stat.icon}
                </span>
              )}
              <span class="theme-accent text-3xl lg:text-4xl font-extrabold leading-none tabular-nums">
                {stat.value}
              </span>
              <span class="theme-heading text-sm font-semibold leading-tight">{stat.label}</span>
              {stat.description && (
                <span class="theme-text-muted text-xs leading-relaxed">{stat.description}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .stat-card {
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    box-shadow: var(--t-shadow-sm);
  }
  .stat-chip {
    background: color-mix(in srgb, var(--theme-accent) 14%, transparent);
  }
</style>
