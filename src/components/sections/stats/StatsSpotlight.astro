---
import type { Eyebrow, StatItem, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

/**
 * stats:spotlight — one hero stat blown up as the focal point with a supporting
 * label + description, and the remaining stats arranged as a smaller proof row
 * beneath. Great for leading with a single headline number. No client JS.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    stats?: StatItem[];
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
    ctas?: SectionCTA[];
  };
}

const { theme = "default", data } = Astro.props;

const stats = data?.stats ?? [];
const hero = stats[0];
const rest = stats.slice(1);

const ctas = (
  data?.ctas?.length ? data.ctas : [data?.cta, data?.secondaryCta].filter(Boolean)
) as SectionCTA[];
---

{
  hero && (
    <section class:list={["stats-spotlight section-wrapper section-py", `theme-${theme}`]}>
      <div class="section-container">
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-sm mb-12">
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                  {data.eyebrow.text}
                </span>
              ))}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>
            )}
          </div>
        )}

        <div class="flex flex-col items-center text-center gap-md">
          <span class="spotlight-number theme-accent font-extrabold leading-none tabular-nums m-0">
            {hero.value}
          </span>
          <span class="theme-heading text-xl lg:text-2xl font-semibold leading-tight max-w-xl">
            {hero.label}
          </span>
          {hero.description && (
            <p class="theme-text-muted text-base leading-relaxed max-w-xl m-0">
              {hero.description}
            </p>
          )}
        </div>

        {rest.length > 0 && (
          <div class="mt-14 pt-10 border-t border-[var(--theme-border)] grid grid-cols-2 lg:grid-cols-3 gap-xl max-w-4xl mx-auto">
            {rest.map((stat) => (
              <div class="flex flex-col items-center text-center gap-1.5">
                <span class="theme-heading text-3xl lg:text-4xl font-bold leading-none tabular-nums">
                  {stat.value}
                </span>
                <span class="theme-text-muted text-sm font-medium leading-tight">{stat.label}</span>
                {stat.description && (
                  <span class="theme-text-subtle text-xs leading-relaxed max-w-[16rem]">
                    {stat.description}
                  </span>
                )}
              </div>
            ))}
          </div>
        )}

        {ctas.length > 0 && (
          <div class="flex flex-wrap justify-center gap-md mt-12">
            {ctas.map((cta, i) => (
              <Button variant={cta.variant ?? (i === 0 ? "primary" : "outline")} href={cta.href}>
                {cta.label}
              </Button>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .spotlight-number {
    font-size: clamp(4rem, 14vw, 9rem);
  }
</style>
