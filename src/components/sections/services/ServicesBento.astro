---
import { getCollection } from "astro:content";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import { Button } from "@/components/starwind/button";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const services = (await getCollection("services"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, data?.limit ?? undefined);

/** Bento sizing: first card is the hero tile, then a repeating asymmetric rhythm. */
const spanFor = (i: number) => {
  if (i === 0) return "lg:col-span-2 lg:row-span-2";
  if (i === 3) return "lg:col-span-2";
  return "";
};
---

<section
  class:list={["services-bento section-wrapper section-py", `theme-${theme}`]}
>
  <div class="section-container">
    {
      (data?.eyebrow || data?.heading || data?.subheading) && (
        <div class="flex flex-col items-center text-center gap-3 mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>
      )
    }

    {
      services.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 lg:auto-rows-[minmax(11rem,auto)] gap-5">
          {services.map((service, i) => (
            <a
              href={`/services/${service.data.slug}`}
              class:list={[
                "bento-tile group flex flex-col justify-between gap-4 p-6 no-underline transition-shadow duration-200",
                spanFor(i),
              ]}
              style="background-color: var(--card); border: var(--t-border-width) solid var(--theme-border); border-radius: var(--t-radius); box-shadow: var(--t-shadow-sm)"
            >
              <div class="flex items-start justify-between gap-3">
                <span
                  class="inline-flex items-center justify-center rounded-full shrink-0 theme-accent"
                  style="width: 2.75rem; height: 2.75rem; background: color-mix(in srgb, currentColor 12%, transparent)"
                >
                  <svg
                    class:list={[i === 0 ? "w-7 h-7" : "w-5 h-5"]}
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m9 11 3 3L22 4" />
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                  </svg>
                </span>
                {service.data.isEmergency && (
                  <Badge variant="secondary" class="uppercase tracking-wide text-[0.65rem]">
                    Emergency
                  </Badge>
                )}
              </div>
              <div class="flex flex-col gap-2">
                <h3
                  class:list={[
                    "theme-heading font-bold m-0 transition-colors group-hover:theme-accent",
                    i === 0 ? "text-2xl" : "text-lg",
                  ]}
                >
                  {service.data.title}
                </h3>
                {service.data.description && (
                  <p
                    class:list={[
                      "theme-text-muted leading-relaxed m-0",
                      i === 0 ? "text-base" : "text-sm line-clamp-3",
                    ]}
                  >
                    {service.data.description}
                  </p>
                )}
              </div>
            </a>
          ))}
        </div>
      )
    }

    {
      data?.cta && (
        <div class="flex justify-center mt-12">
          <Button href={data.cta.href} variant={data.cta.variant ?? "primary"}>
            {data.cta.label}
          </Button>
        </div>
      )
    }
  </div>
</section>
