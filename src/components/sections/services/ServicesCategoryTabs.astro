---
import { getServiceGroups } from "@/lib/services";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import { Button } from "@/components/starwind/button";
import {
  Tabs,
  TabsList,
  TabsTrigger,
  TabsContent,
} from "@/components/starwind/tabs";

/**
 * services:category-tabs — one tab per service `category`, with that category's
 * services as a card grid inside. Great for a services page where each category
 * is a distinct offering. Falls back to a single "All" tab if no categories set.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const limit = data?.limit;
const groups = (await getServiceGroups()).map((g, i) => ({
  id: `cat-${i}`,
  title: g.title,
  services: limit ? g.services.slice(0, limit) : g.services,
}));
---

<section class={`services-category-tabs section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    <div class="flex flex-col items-center text-center gap-3 mb-12">
      {
        data?.eyebrow &&
          (data.eyebrow.variant === "badge" ? (
            <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
          ) : (
            <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
              {data.eyebrow.text}
            </span>
          ))
      }
      {data?.heading && <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>}
      {data?.subheading && <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>}
    </div>

    {
      groups.length > 0 && (
        <Tabs defaultValue={groups[0].id} class="w-full max-w-5xl mx-auto">
          <TabsList class="flex-wrap justify-center">
            {groups.map((group) => (
              <TabsTrigger value={group.id}>{group.title}</TabsTrigger>
            ))}
          </TabsList>

          {groups.map((group) => (
            <TabsContent value={group.id}>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-4">
                {group.services.map((service) => (
                  <a
                    href={`/services/${service.data.slug}`}
                    class="group flex flex-col gap-3 p-6 rounded-xl border theme-border bg-background hover:shadow-md transition-all duration-200 no-underline"
                  >
                    <div class="flex items-start justify-between gap-2">
                      <h3 class="theme-heading text-lg font-semibold m-0">{service.data.title}</h3>
                      {service.data.isEmergency && (
                        <span class="shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full svc-emergency">
                          Emergency
                        </span>
                      )}
                    </div>
                    {service.data.description && (
                      <p class="theme-text-muted text-sm leading-relaxed m-0 flex-1">
                        {service.data.description}
                      </p>
                    )}
                    <span class="text-sm font-semibold theme-accent flex items-center gap-1 mt-auto">
                      Learn more
                      <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                      </svg>
                    </span>
                  </a>
                ))}
              </div>
            </TabsContent>
          ))}
        </Tabs>
      )
    }

    {
      data?.cta && (
        <div class="flex justify-center mt-12">
          <Button variant={data.cta.variant ?? "primary"} href={data.cta.href}>{data.cta.label}</Button>
        </div>
      )
    }
  </div>
</section>

<style>
  .svc-emergency {
    background: color-mix(in srgb, var(--color-brand-secondary) 15%, transparent);
    color: var(--theme-accent);
  }
</style>
