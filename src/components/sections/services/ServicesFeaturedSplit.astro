---
import { getCollection } from "astro:content";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import SmartImage from "@/components/media/SmartImage.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
  };
}

const { theme = "default", data } = Astro.props;

const services = await getCollection("services");
const sorted = services
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, data?.limit ?? services.length);

const featured = sorted[0];
const rest = sorted.slice(1);
---

{
  featured && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-3 mb-12">
            {data?.eyebrow && (
              <div>
                {data.eyebrow.variant === "badge" ? (
                  <Badge class="uppercase tracking-widest text-xs">
                    {data.eyebrow.text}
                  </Badge>
                ) : (
                  <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                    {data.eyebrow.text}
                  </span>
                )}
              </div>
            )}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg max-w-2xl m-0">
                {data.subheading}
              </p>
            )}
          </div>
        )}

        {/* Split layout */}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
          {/* Featured service */}
          <a
            href={`/services/${featured.data.slug}`}
            class="group flex flex-col rounded-xl border theme-border bg-background overflow-hidden hover:shadow-md transition-all duration-200 no-underline"
          >
            {featured.data.image && (
              <div class="aspect-[16/10] overflow-hidden">
                <SmartImage
                  src={featured.data.image}
                  alt={featured.data.title}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
            )}
            <div class="flex flex-col gap-3 p-6">
              <div class="flex items-start justify-between gap-2">
                <h3 class="theme-heading text-2xl font-bold m-0 group-hover:text-primary transition-colors">
                  {featured.data.title}
                </h3>
                {featured.data.isEmergency && (
                  <span
                    class="shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full"
                    style="background: color-mix(in srgb, var(--color-brand-secondary) 15%, transparent); color: var(--color-brand-secondary-fg)"
                  >
                    Emergency
                  </span>
                )}
              </div>
              {featured.data.description && (
                <p class="theme-text-muted text-base leading-relaxed m-0">
                  {featured.data.description}
                </p>
              )}
              <span class="text-sm font-semibold text-primary flex items-center gap-1 mt-1">
                Learn more
                <svg
                  class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>

          {/* Remaining services list */}
          {rest.length > 0 && (
            <div class="flex flex-col gap-3">
              {rest.map((service) => (
                <a
                  href={`/services/${service.data.slug}`}
                  class="group flex items-start gap-3 p-5 rounded-xl border theme-border bg-background hover:bg-muted transition-all duration-200 no-underline"
                >
                  <div class="flex flex-col gap-1 flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-2">
                      <h3 class="theme-heading text-base font-semibold m-0 group-hover:text-primary transition-colors">
                        {service.data.title}
                      </h3>
                      {service.data.isEmergency && (
                        <span
                          class="shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full"
                          style="background: color-mix(in srgb, var(--color-brand-secondary) 15%, transparent); color: var(--color-brand-secondary-fg)"
                        >
                          Emergency
                        </span>
                      )}
                    </div>
                    {service.data.description && (
                      <p class="theme-text-muted text-sm leading-relaxed m-0 line-clamp-2">
                        {service.data.description}
                      </p>
                    )}
                  </div>
                  <svg
                    class="w-4 h-4 mt-1 shrink-0 theme-text-muted transition-transform duration-200 group-hover:translate-x-1 group-hover:text-primary"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
