---
import { getServices } from "@/lib/content";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const services = (await getServices())
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, data?.limit ?? undefined);
---

<section
  class:list={["services-numbered section-wrapper section-py", `theme-${theme}`]}
>
  <div class="section-container">
    {
      (data?.eyebrow || data?.heading || data?.subheading) && (
        <div class="flex flex-col items-center text-center gap-sm mb-14">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>
      )
    }

    {
      services.length > 0 && (
        <ol
          class="list-none m-0 p-0 max-w-4xl mx-auto"
          style="border-top: var(--t-border-width) solid var(--theme-border)"
        >
          {services.map((service, i) => (
            <li
              style="border-bottom: var(--t-border-width) solid var(--theme-border)"
            >
              <a
                href={`/services/${service.data.slug}`}
                class="numbered-row group grid grid-cols-[auto_1fr_auto] items-start gap-5 sm:gap-xl py-8 no-underline"
              >
                <span
                  class="numbered-index font-bold leading-none tabular-nums select-none theme-text-subtle transition-colors group-hover:theme-accent"
                  style="font-size: clamp(2.25rem, 6vw, 3.75rem)"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="flex flex-col gap-xs min-w-0 pt-1">
                  <div class="flex items-center gap-sm flex-wrap">
                    <h3 class="theme-heading text-xl sm:text-2xl font-semibold m-0 transition-colors group-hover:theme-accent">
                      {service.data.title}
                    </h3>
                    {service.data.isEmergency && (
                      <Badge variant="secondary" class="uppercase tracking-wide text-[0.65rem]">
                        Emergency
                      </Badge>
                    )}
                  </div>
                  {service.data.description && (
                    <p class="theme-text-muted text-base leading-relaxed m-0 max-w-2xl">
                      {service.data.description}
                    </p>
                  )}
                </div>
                <svg
                  class="w-5 h-5 mt-3 shrink-0 theme-text-subtle transition-transform duration-200 group-hover:translate-x-1 group-hover:theme-accent"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            </li>
          ))}
        </ol>
      )
    }

    {
      data?.cta && (
        <div class="flex justify-center mt-12">
          <Button href={data.cta.href} variant={data.cta.variant ?? "outline"}>
            {data.cta.label}
          </Button>
        </div>
      )
    }
  </div>
</section>
