---
import { getServices } from "@/lib/content";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import SmartImage from "@/components/media/SmartImage.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
  };
}

const { theme = "default", data } = Astro.props;

const services = await getServices();
const sorted = services
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, data?.limit ?? services.length);

// Unique id so multiple instances on one page stay independent
const carouselId = `services-carousel-${Math.random().toString(36).slice(2, 9)}`;
---

{
  sorted.length > 0 && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-sm mb-12">
            {data?.eyebrow && (
              <div>
                {data.eyebrow.variant === "badge" ? (
                  <Badge class="uppercase tracking-widest text-xs">
                    {data.eyebrow.text}
                  </Badge>
                ) : (
                  <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                    {data.eyebrow.text}
                  </span>
                )}
              </div>
            )}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg max-w-2xl m-0">
                {data.subheading}
              </p>
            )}
          </div>
        )}

        {/* Carousel */}
        <div class="carousel" data-carousel id={carouselId}>
          {/* Track */}
          <div class="carousel-track" data-carousel-track>
            {sorted.map((service) => (
              <a
                href={`/services/${service.data.slug}`}
                class="carousel-card group flex flex-col rounded-xl border theme-border bg-background overflow-hidden no-underline"
              >
                {service.data.image && (
                  <div class="aspect-[16/10] overflow-hidden">
                    <SmartImage
                      src={service.data.image}
                      alt={service.data.title}
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  </div>
                )}
                <div class="flex flex-col gap-sm p-6 flex-1">
                  <div class="flex items-start justify-between gap-xs">
                    <h3 class="theme-heading text-lg font-semibold m-0 group-hover:text-primary transition-colors">
                      {service.data.title}
                    </h3>
                    {service.data.isEmergency && (
                      <span
                        class="shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full"
                        style="background: color-mix(in srgb, var(--color-brand-secondary) 15%, transparent); color: var(--color-brand-secondary-fg)"
                      >
                        Emergency
                      </span>
                    )}
                  </div>
                  {service.data.description && (
                    <p class="theme-text-muted text-sm leading-relaxed m-0 flex-1">
                      {service.data.description}
                    </p>
                  )}
                  <span class="text-sm font-semibold text-primary flex items-center gap-1 mt-auto">
                    Learn more
                    <svg
                      class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </a>
            ))}
          </div>

          {/* Controls */}
          <div class="carousel-controls">
            <button
              type="button"
              class="carousel-arrow border theme-border bg-background hover:bg-muted"
              data-carousel-prev
              aria-label="Previous service"
            >
              <svg
                class="w-5 h-5"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </button>
            <button
              type="button"
              class="carousel-arrow border theme-border bg-background hover:bg-muted"
              data-carousel-next
              aria-label="Next service"
            >
              <svg
                class="w-5 h-5"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  function initServiceCarousels() {
    const carousels = document.querySelectorAll<HTMLElement>("[data-carousel]");

    carousels.forEach((root) => {
      if (root.dataset.carouselReady === "true") return;
      root.dataset.carouselReady = "true";

      const track = root.querySelector<HTMLElement>("[data-carousel-track]");
      const prev = root.querySelector<HTMLElement>("[data-carousel-prev]");
      const next = root.querySelector<HTMLElement>("[data-carousel-next]");
      if (!track) return;

      const scrollByCard = (dir: number) => {
        const card = track.querySelector<HTMLElement>(".carousel-card");
        const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0;
        const amount = card ? card.offsetWidth + gap : track.clientWidth * 0.85;
        track.scrollBy({ left: amount * dir, behavior: "smooth" });
      };

      prev?.addEventListener("click", () => scrollByCard(-1));
      next?.addEventListener("click", () => scrollByCard(1));

      const updateArrows = () => {
        const maxScroll = track.scrollWidth - track.clientWidth - 1;
        if (prev) (prev as HTMLButtonElement).disabled = track.scrollLeft <= 0;
        if (next)
          (next as HTMLButtonElement).disabled = track.scrollLeft >= maxScroll;
      };

      track.addEventListener("scroll", updateArrows, { passive: true });
      window.addEventListener("resize", updateArrows);
      updateArrows();
    });
  }

  initServiceCarousels();
  document.addEventListener("astro:page-load", initServiceCarousels);
</script>

<style>
  .carousel {
    position: relative;
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 0.25rem;
    /* Hide scrollbar — Firefox */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  /* Hide scrollbar — WebKit */
  .carousel-track::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .carousel-card {
    scroll-snap-align: start;
    flex: 0 0 auto;
    min-width: 85%;
    box-shadow: var(--t-shadow-md);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .carousel-card:hover {
    box-shadow: var(--t-shadow-lg);
  }

  @media (min-width: 640px) {
    .carousel-card {
      min-width: 45%;
    }
  }

  @media (min-width: 1024px) {
    .carousel-card {
      min-width: 31%;
    }
  }

  .carousel-controls {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .carousel-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-fg);
    cursor: pointer;
    transition:
      background 0.2s ease,
      opacity 0.2s ease;
  }

  .carousel-arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }
</style>
