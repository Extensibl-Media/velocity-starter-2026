---
import { getServiceGroups } from "@/lib/services";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

/**
 * services:by-category — services grouped under their `category` taxonomy.
 * Each distinct category renders as a labeled subsection with a card grid.
 * Services with no category fall into a final "More Services" group. Optionally
 * restrict + order the groups via `categories` (blank = all, by first appearance).
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    /** Max services shown per category. */
    limit?: number;
    /** Only these categories, in this order. Blank = all groups by first appearance. */
    categories?: string[];
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const limit = data?.limit;
const groups = (await getServiceGroups(data?.categories)).map((g) => ({
  ...g,
  services: limit ? g.services.slice(0, limit) : g.services,
}));
---

<section class={`services-by-category section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    {/* Section header */}
    <div class="flex flex-col items-center text-center gap-sm mb-12">
      {
        data?.eyebrow &&
          (data.eyebrow.variant === "badge" ? (
            <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
          ) : (
            <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
              {data.eyebrow.text}
            </span>
          ))
      }
      {
        data?.heading && (
          <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>
        )
      }
      {
        data?.subheading && (
          <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>
        )
      }
    </div>

    {/* Category groups */}
    <div class="flex flex-col gap-12">
      {
        groups.map((group) => (
          <div>
            <div class="flex items-center gap-md mb-6">
              <h3 class="theme-heading text-xl font-bold m-0 whitespace-nowrap">{group.title}</h3>
              <span class="flex-1 border-t theme-border" aria-hidden="true" />
              <span class="text-sm theme-text-muted whitespace-nowrap">
                {group.services.length}
                {group.services.length === 1 ? " service" : " services"}
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-lg">
              {group.services.map((service) => (
                <a
                  href={`/services/${service.data.slug}`}
                  class="group flex flex-col gap-sm p-6 rounded-xl border theme-border bg-background hover:shadow-md transition-all duration-200 no-underline"
                >
                  <div class="flex items-start justify-between gap-xs">
                    <h4 class="theme-heading text-lg font-semibold m-0">{service.data.title}</h4>
                    {service.data.isEmergency && (
                      <span class="shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full svc-emergency">
                        Emergency
                      </span>
                    )}
                  </div>
                  {service.data.description && (
                    <p class="theme-text-muted text-sm leading-relaxed m-0 flex-1">
                      {service.data.description}
                    </p>
                  )}
                  <span class="text-sm font-semibold theme-accent flex items-center gap-1 mt-auto">
                    Learn more
                    <svg
                      class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    {/* Optional CTA */}
    {
      data?.cta && (
        <div class="flex justify-center mt-12">
          <Button variant={data.cta.variant ?? "primary"} href={data.cta.href}>
            {data.cta.label}
          </Button>
        </div>
      )
    }
  </div>
</section>

<style>
  .svc-emergency {
    background: color-mix(in srgb, var(--color-brand-secondary) 15%, transparent);
    color: var(--theme-accent);
  }
</style>
