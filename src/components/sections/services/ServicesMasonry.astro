---
import { getServices } from "@/lib/content";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const services = (await getServices())
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, data?.limit ?? undefined);
---

<section
  class:list={["services-masonry section-wrapper section-py", `theme-${theme}`]}
>
  <div class="section-container">
    {
      (data?.eyebrow || data?.heading || data?.subheading) && (
        <div class="flex flex-col items-center text-center gap-sm mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>
      )
    }

    {
      services.length > 0 && (
        <div class="masonry-cols gap-5 [column-fill:_balance] columns-1 sm:columns-2 lg:columns-3">
          {services.map((service) => (
            <a
              href={`/services/${service.data.slug}`}
              class="group mb-5 break-inside-avoid flex flex-col gap-sm p-6 no-underline transition-shadow duration-200"
              style="background-color: var(--card); border: var(--t-border-width) solid var(--theme-border); border-radius: var(--t-radius); box-shadow: var(--t-shadow-sm)"
            >
              <div class="flex items-start justify-between gap-xs">
                <span
                  class="inline-flex items-center justify-center rounded-full shrink-0 theme-accent"
                  style="width: 2.5rem; height: 2.5rem; background: color-mix(in srgb, currentColor 12%, transparent)"
                >
                  <svg
                    class="w-5 h-5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 2 2 7l10 5 10-5-10-5Z" />
                    <path d="m2 17 10 5 10-5" />
                    <path d="m2 12 10 5 10-5" />
                  </svg>
                </span>
                {service.data.isEmergency && (
                  <Badge variant="secondary" class="uppercase tracking-wide text-[0.65rem]">
                    Emergency
                  </Badge>
                )}
              </div>
              <h3 class="theme-heading text-lg font-semibold m-0 transition-colors group-hover:theme-accent">
                {service.data.title}
              </h3>
              {service.data.description && (
                <p class="theme-text-muted text-sm leading-relaxed m-0">
                  {service.data.description}
                </p>
              )}
              <span class="text-sm font-semibold theme-accent flex items-center gap-1 mt-1">
                Learn more
                <svg
                  class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      )
    }

    {
      data?.cta && (
        <div class="flex justify-center mt-12">
          <Button href={data.cta.href} variant={data.cta.variant ?? "primary"}>
            {data.cta.label}
          </Button>
        </div>
      )
    }
  </div>
</section>
