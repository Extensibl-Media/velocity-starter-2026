---
import { getCollection } from "astro:content";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
  };
}

const { theme = "default", data } = Astro.props;

const services = await getCollection("services");
const sorted = services
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, data?.limit ?? services.length);

const count = sorted.length;
const gridClass =
  count === 1
    ? "grid-cols-1"
    : count === 2
      ? "grid-cols-1 sm:grid-cols-2"
      : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3";
---

<section class={`section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    {/* Section header */}
    <div class="flex flex-col items-center text-center gap-3 mb-12">
      {
        data?.eyebrow && (
          <div>
            {data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            )}
          </div>
        )
      }
      {
        data?.heading && (
          <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
            {data.heading}
          </h2>
        )
      }
      {
        data?.subheading && (
          <p class="theme-text-muted text-lg max-w-2xl m-0">
            {data.subheading}
          </p>
        )
      }
    </div>

    {/* Icon grid */}
    {
      sorted.length > 0 && (
        <div class={`grid ${gridClass} gap-6`}>
          {sorted.map((service) => (
            <a
              href={`/services/${service.data.slug}`}
              class="group flex flex-col gap-4 p-6 rounded-xl border theme-border bg-background hover:shadow-md transition-all duration-200 no-underline"
            >
              <div class="flex items-start justify-between gap-2">
                <span
                  class="inline-flex items-center justify-center w-12 h-12 rounded-full shrink-0"
                  style="background: color-mix(in srgb, var(--theme-accent) 12%, transparent); color: var(--theme-accent)"
                >
                  <svg
                    class="w-6 h-6"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M3 10.5 12 3l9 7.5" />
                    <path d="M5 9.5V21h14V9.5" />
                    <path d="m9 21v-6h6v6" />
                  </svg>
                </span>
                {service.data.isEmergency && (
                  <span
                    class="shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full"
                    style="background: color-mix(in srgb, var(--color-brand-secondary) 15%, transparent); color: var(--color-brand-secondary-fg)"
                  >
                    Emergency
                  </span>
                )}
              </div>
              <h3 class="theme-heading text-lg font-semibold m-0 group-hover:text-primary transition-colors">
                {service.data.title}
              </h3>
              {service.data.description && (
                <p class="theme-text-muted text-sm leading-relaxed m-0 flex-1">
                  {service.data.description}
                </p>
              )}
              <span class="text-sm font-semibold text-primary flex items-center gap-1 mt-auto">
                Learn more
                <svg
                  class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>
