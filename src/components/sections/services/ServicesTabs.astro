---
import { getCollection } from "astro:content";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import SmartImage from "@/components/media/SmartImage.astro";
import {
  Tabs,
  TabsList,
  TabsTrigger,
  TabsContent,
} from "@/components/starwind/tabs";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
  };
}

const { theme = "default", data } = Astro.props;

const services = await getCollection("services");
const sorted = services
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, data?.limit ?? services.length);
---

<section class={`section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    {/* Section header */}
    <div class="flex flex-col items-center text-center gap-3 mb-12">
      {
        data?.eyebrow && (
          <div>
            {data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            )}
          </div>
        )
      }
      {
        data?.heading && (
          <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
            {data.heading}
          </h2>
        )
      }
      {
        data?.subheading && (
          <p class="theme-text-muted text-lg max-w-2xl m-0">
            {data.subheading}
          </p>
        )
      }
    </div>

    {/* Tabs */}
    {
      sorted.length > 0 && (
        <Tabs defaultValue="svc-0" class="w-full max-w-4xl mx-auto">
          <TabsList class="flex-wrap">
            {sorted.map((service, i) => (
              <TabsTrigger value={`svc-${i}`}>{service.data.title}</TabsTrigger>
            ))}
          </TabsList>

          {sorted.map((service, i) => (
            <TabsContent value={`svc-${i}`}>
              <div class="grid gap-6 md:grid-cols-2 items-center">
                <div class="flex flex-col gap-3">
                  <div class="flex items-center gap-2">
                    <h3 class="theme-heading text-2xl font-bold m-0">
                      {service.data.title}
                    </h3>
                    {service.data.isEmergency && (
                      <span
                        class="shrink-0 text-xs font-semibold px-2 py-0.5 rounded-full"
                        style="background: color-mix(in srgb, var(--color-brand-secondary) 15%, transparent); color: var(--color-brand-secondary-fg)"
                      >
                        Emergency
                      </span>
                    )}
                  </div>
                  {service.data.description && (
                    <p class="theme-text-muted text-base leading-relaxed m-0">
                      {service.data.description}
                    </p>
                  )}
                  <a
                    href={`/services/${service.data.slug}`}
                    class="text-sm font-semibold text-primary inline-flex items-center gap-1 no-underline self-start group mt-2"
                  >
                    Learn more
                    <svg
                      class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
                {service.data.image && (
                  <div class="rounded-xl border theme-border bg-background overflow-hidden">
                    <SmartImage
                      src={service.data.image}
                      alt={service.data.title}
                      width={640}
                      class="w-full h-full object-cover"
                    />
                  </div>
                )}
              </div>
            </TabsContent>
          ))}
        </Tabs>
      )
    }
  </div>
</section>
