---
import { getServices } from "@/lib/content";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const services = (await getServices())
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, data?.limit ?? undefined);
---

<section
  class:list={["services-sidebar-cta section-wrapper section-py", `theme-${theme}`]}
>
  <div class="section-container">
    <div class="grid grid-cols-1 lg:grid-cols-[22rem_1fr] gap-10 lg:gap-14 items-start">
      {/* Sticky sidebar with header + CTA */}
      <aside class="lg:sticky lg:top-24 flex flex-col gap-5">
        {
          data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs w-fit">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                {data.eyebrow.text}
              </span>
            ))
        }
        {
          data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )
        }
        {
          data?.subheading && (
            <p class="theme-text-muted text-lg m-0">{data.subheading}</p>
          )
        }
        {
          data?.cta && (
            <div
              class="flex flex-col gap-sm p-6 mt-2"
              style="background-color: var(--card); border: var(--t-border-width) solid var(--theme-border); border-radius: var(--t-radius); box-shadow: var(--t-shadow-md)"
            >
              <p class="theme-text text-sm font-medium m-0">
                Not sure which service fits? Let's talk it through.
              </p>
              <Button
                href={data.cta.href}
                variant={data.cta.variant ?? "primary"}
                class="w-full"
              >
                {data.cta.label}
              </Button>
            </div>
          )
        }
      </aside>

      {/* Services grid */}
      {
        services.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {services.map((service) => (
              <a
                href={`/services/${service.data.slug}`}
                class="group flex flex-col gap-sm p-6 no-underline transition-shadow duration-200"
                style="background-color: var(--card); border: var(--t-border-width) solid var(--theme-border); border-radius: var(--t-radius); box-shadow: var(--t-shadow-sm)"
              >
                <div class="flex items-start justify-between gap-xs">
                  <span
                    class="inline-flex items-center justify-center rounded-full shrink-0 theme-accent"
                    style="width: 2.5rem; height: 2.5rem; background: color-mix(in srgb, currentColor 12%, transparent)"
                  >
                    <svg
                      class="w-5 h-5"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m9 11 3 3L22 4" />
                      <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                    </svg>
                  </span>
                  {service.data.isEmergency && (
                    <Badge variant="secondary" class="uppercase tracking-wide text-[0.65rem]">
                      Emergency
                    </Badge>
                  )}
                </div>
                <h3 class="theme-heading text-lg font-semibold m-0 transition-colors group-hover:theme-accent">
                  {service.data.title}
                </h3>
                {service.data.description && (
                  <p class="theme-text-muted text-sm leading-relaxed m-0 flex-1">
                    {service.data.description}
                  </p>
                )}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
