---
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import { Button } from "@/components/starwind/button";

/**
 * guarantee:seal-spotlight — a warranty "seal" medallion spotlighted beside a
 * heading, supporting copy, a list of covered points, and a CTA. The seal uses
 * theme-accent so it reads as an official mark. Stacks on mobile (seal first).
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    seal?: string;
    bullets?: string[];
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
    ctas?: SectionCTA[];
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();

const ctas = (
  data?.ctas?.length ? data.ctas : [data?.cta, data?.secondaryCta].filter(Boolean)
) as SectionCTA[];
const bullets = data?.bullets ?? [];
---

<section class:list={["guarantee-seal-spotlight section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-10 lg:gap-16 items-center">
      <div class="flex justify-center lg:justify-start">
        <div class="seal-medallion flex flex-col items-center justify-center text-center shrink-0">
          <svg class="w-9 h-9 mb-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
          {data?.seal && <span class="seal-text font-bold leading-tight">{data.seal}</span>}
        </div>
      </div>

      <div class="flex flex-col gap-5">
        {data?.eyebrow &&
          (data.eyebrow.variant === "badge" ? (
            <Badge class="uppercase tracking-widest text-xs self-start">{data.eyebrow.text}</Badge>
          ) : (
            <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
              {data.eyebrow.text}
            </span>
          ))}

        {data?.heading && (
          <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>
        )}

        {data?.subheading && (
          <p class="theme-text-muted text-lg leading-relaxed max-w-2xl m-0">{data.subheading}</p>
        )}

        {bullets.length > 0 && (
          <ul class="flex flex-col gap-3 list-none m-0 p-0">
            {bullets.map((b) => (
              <li class="flex items-start gap-3 theme-text">
                <svg class="w-5 h-5 theme-accent shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span class="leading-snug">{b}</span>
              </li>
            ))}
          </ul>
        )}

        {ctas.length > 0 && (
          <div class="flex flex-wrap items-center gap-4 mt-2">
            {ctas.map((cta, i) => (
              <Button variant={cta.variant ?? (i === 0 ? "primary" : "outline")} href={cta.href}>
                {cta.label}
              </Button>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .seal-medallion {
    width: 11rem;
    height: 11rem;
    border-radius: 9999px;
    background-color: var(--theme-accent, var(--color-primary));
    color: var(--color-fg-on-primary, #fff);
    padding: 1.5rem;
    box-shadow: var(--t-shadow-lg);
    outline: 4px solid color-mix(in srgb, currentColor 25%, transparent);
    outline-offset: 6px;
  }
  .seal-text {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
