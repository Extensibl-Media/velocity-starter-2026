---
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import { Button } from "@/components/starwind/button";

/**
 * guarantee:pledge-banner — a bold full-width pledge banner (money-back /
 * no-leak style). A big pledge headline and short guarantee statement lead
 * into a numbered list of promises rendered inline, closed with a CTA and
 * optional phone. Uses a primary/inverse theme to stand out as a commitment.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    body?: string;
    bullets?: string[];
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
    ctas?: SectionCTA[];
    showPhone?: boolean;
  };
}

const { theme = "primary", data } = Astro.props;
const business = await getBusinessData();

const ctas = (
  data?.ctas?.length ? data.ctas : [data?.cta, data?.secondaryCta].filter(Boolean)
) as SectionCTA[];
const bullets = data?.bullets ?? [];
---

<section class:list={["guarantee-pledge-banner section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    <div class="pledge-inner flex flex-col items-center text-center gap-6 max-w-4xl mx-auto">
      {data?.eyebrow && (
        <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
          {data.eyebrow.text}
        </span>
      )}

      {data?.heading && (
        <h2 class="theme-heading text-3xl lg:text-5xl font-extrabold leading-tight m-0">
          {data.heading}
        </h2>
      )}

      {data?.body && (
        <p class="theme-text-muted text-lg lg:text-xl leading-relaxed max-w-2xl m-0">
          {data.body}
        </p>
      )}

      {bullets.length > 0 && (
        <ol class="pledge-list grid grid-cols-1 sm:grid-cols-3 gap-6 list-none m-0 p-0 w-full mt-2">
          {bullets.map((b, i) => (
            <li class="flex flex-col items-center gap-3 text-center">
              <span class="pledge-num flex items-center justify-center w-11 h-11 rounded-full font-bold shrink-0">
                {i + 1}
              </span>
              <span class="theme-text leading-snug">{b}</span>
            </li>
          ))}
        </ol>
      )}

      {(ctas.length > 0 || data?.showPhone) && (
        <div class="flex flex-wrap items-center justify-center gap-4 mt-4">
          {ctas.map((cta, i) => (
            <Button variant={cta.variant ?? (i === 0 ? "primary" : "outline")} href={cta.href}>
              {cta.label}
            </Button>
          ))}
          {data?.showPhone && business.phone && (
            <a href={`tel:${business.phone}`} class="inline-flex items-center gap-2 font-semibold text-base theme-text no-underline hover:opacity-80 transition-opacity">
              <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              {business.phone}
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .pledge-num {
    background-color: var(--theme-accent, var(--color-primary));
    color: var(--color-fg-on-primary, #fff);
    box-shadow: var(--t-shadow-sm);
  }
</style>
