---
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";

/**
 * guarantee:promise-signature — a personal-promise panel: heading, promise
 * body, and a signature block (owner name + role) closing it like a signed
 * pledge. A single raised card centered on the section for a personal, human
 * commitment feel.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    body?: string;
    seal?: string;
    signatureName?: string;
    signatureRole?: string;
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();

const signatureName = data?.signatureName ?? business.businessName;
const signatureRole = data?.signatureRole;
---

{
  (data?.heading || data?.body) && (
    <section class:list={["guarantee-promise-signature section-wrapper section-py", `theme-${theme}`]}>
      <div class="section-container">
        <div class="promise-card flex flex-col gap-6 max-w-3xl mx-auto p-8 lg:p-12">
          <div class="flex items-center justify-between gap-4 flex-wrap">
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                  {data.eyebrow.text}
                </span>
              ))}
            {data?.seal && (
              <span class="promise-seal inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest px-3 py-1.5 rounded-full">
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {data.seal}
              </span>
            )}
          </div>

          {data?.heading && (
            <h2 class="theme-heading text-2xl lg:text-3xl font-bold m-0">{data.heading}</h2>
          )}

          {data?.body && (
            <p class="theme-text-muted text-lg leading-relaxed m-0">{data.body}</p>
          )}

          {signatureName && (
            <div class="signature-block flex flex-col gap-1 pt-6 mt-2">
              <span class="signature-name theme-heading">{signatureName}</span>
              {signatureRole && (
                <span class="theme-text-subtle text-sm">{signatureRole}</span>
              )}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .promise-card {
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    box-shadow: var(--t-shadow-md);
  }
  .promise-seal {
    background-color: var(--theme-accent, var(--color-primary));
    color: var(--color-fg-on-primary, #fff);
  }
  .signature-block {
    border-top: var(--t-border-width) solid var(--theme-border);
  }
  .signature-name {
    font-size: 1.75rem;
    font-weight: 600;
    font-style: italic;
    font-family: Georgia, "Times New Roman", serif;
  }
</style>
