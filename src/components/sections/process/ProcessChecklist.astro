---
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow, ProcessStep, SectionCTA } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import { Button } from "@/components/starwind/button";

/**
 * process:checklist — a "how it works" checklist. Two-column on desktop:
 * heading + supporting copy + CTA on the left, and a raised card on the right
 * holding a numbered, check-marked list of the steps. Each step reads like a
 * box you can tick off. Stacks with the copy first on mobile.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    listTitle?: string;
    steps?: ProcessStep[];
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
    ctas?: SectionCTA[];
    showPhone?: boolean;
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();

const defaultSteps: ProcessStep[] = [
  {
    heading: "Tell us what's wrong",
    body: "Call or send photos — we'll know how to help right away.",
  },
  {
    heading: "Get a free, honest estimate",
    body: "On-site inspection with clear pricing and no upsells.",
  },
  {
    heading: "Pick a time that works",
    body: "Flexible scheduling, including emergency same-day slots.",
  },
  {
    heading: "We fix it and clean up",
    body: "Quality workmanship, backed by a written warranty.",
  },
];

const steps = data?.steps?.length ? data.steps : defaultSteps;

const ctas = (
  data?.ctas?.length
    ? data.ctas
    : [data?.cta, data?.secondaryCta].filter(Boolean)
) as SectionCTA[];
---

<section
  class:list={["process-checklist section-wrapper section-py", `theme-${theme}`]}
>
  <div class="section-container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      {/* Left: copy + CTA */}
      <div class="flex flex-col gap-5">
        {
          data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs self-start">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                {data.eyebrow.text}
              </span>
            ))
        }
        {
          data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )
        }
        {
          data?.subheading && (
            <p class="theme-text-muted text-lg leading-relaxed m-0">
              {data.subheading}
            </p>
          )
        }

        {
          (ctas.length > 0 || data?.showPhone) && (
            <div class="flex flex-wrap items-center gap-4 mt-2">
              {ctas.map((cta, i) => (
                <Button
                  variant={cta.variant ?? (i === 0 ? "primary" : "outline")}
                  href={cta.href}
                >
                  {cta.label}
                </Button>
              ))}
              {data?.showPhone && business.phone && (
                <a
                  href={`tel:${business.phone}`}
                  class="inline-flex items-center gap-2 font-semibold text-base theme-text no-underline hover:opacity-80 transition-opacity"
                >
                  <svg
                    class="w-4 h-4 shrink-0"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                  {business.phone}
                </a>
              )}
            </div>
          )
        }
      </div>

      {/* Right: checklist card */}
      <div class="cl-card">
        {
          data?.listTitle && (
            <h3 class="theme-heading font-bold text-lg m-0 mb-5">
              {data.listTitle}
            </h3>
          )
        }
        <ol class="cl-list">
          {
            steps.map((step, index) => (
              <li class="cl-item">
                <span class="cl-check" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                <div class="cl-body">
                  <div class="flex items-baseline gap-2">
                    <span class="cl-index">{index + 1}.</span>
                    <h4 class="theme-heading font-semibold text-base m-0">
                      {step.heading}
                    </h4>
                  </div>
                  {step.body && (
                    <p class="theme-text-muted text-sm leading-relaxed m-0 mt-1">
                      {step.body}
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .cl-card {
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    box-shadow: var(--t-shadow-lg);
    padding: 2rem;
  }

  .cl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .cl-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 0;
    border-top: var(--t-border-width) solid var(--theme-border);
  }

  .cl-item:first-child {
    border-top: none;
    padding-top: 0;
  }

  .cl-item:last-child {
    padding-bottom: 0;
  }

  .cl-check {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-fg-on-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.1rem;
  }

  .cl-check svg {
    width: 1rem;
    height: 1rem;
  }

  .cl-index {
    font-weight: 800;
    color: var(--theme-accent);
    font-size: 0.95rem;
    line-height: 1.2;
  }
</style>
