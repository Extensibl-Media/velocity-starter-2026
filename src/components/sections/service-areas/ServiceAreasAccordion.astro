---
import { getServiceAreas } from "@/lib/content";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import {
  Accordion,
  AccordionItem,
  AccordionTrigger,
  AccordionContent,
} from "@/components/blocks/accordion";

/**
 * service-areas:accordion — service areas grouped by county and rendered as
 * expandable accordion sections. Areas without a `county` fall under "Other".
 * The first group is open by default. If `hrefBase` is set, each city links to
 * `${hrefBase}/${slug}`; otherwise cities render as plain text.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    featuredOnly?: boolean;
    limit?: number;
    hrefBase?: string;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const all = await getServiceAreas();
let areas = all.sort((a, b) => a.data.order - b.data.order);
if (data?.featuredOnly) areas = areas.filter((a) => a.data.featured);
if (data?.limit) areas = areas.slice(0, data.limit);

const hrefBase = data?.hrefBase?.replace(/\/$/, "");

// Group by county (preserving sorted order), fallback "Other".
const groupMap = new Map<string, typeof areas>();
for (const area of areas) {
  const key = area.data.county ? `${area.data.county} County` : "Other";
  const bucket = groupMap.get(key);
  if (bucket) bucket.push(area);
  else groupMap.set(key, [area]);
}
const groups = [...groupMap.entries()];
---

{
  areas.length > 0 && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Header */}
        <div class="flex flex-col items-center text-center gap-sm mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>
          )}
        </div>

        {/* Accordion */}
        <div class="max-w-3xl mx-auto">
          <Accordion type="single" defaultValue="area-0">
            {groups.map(([county, cities], i) => (
              <AccordionItem value={`area-${i}`}>
                <AccordionTrigger class="text-left font-semibold theme-heading">
                  <span class="flex items-center gap-sm">
                    <span>{county}</span>
                    <span class="theme-text-subtle text-sm font-normal">{cities.length}</span>
                  </span>
                </AccordionTrigger>
                <AccordionContent class="theme-text-muted leading-relaxed">
                  <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-lg gap-y-xs list-none p-0 m-0">
                    {cities.map((area) => {
                      const label = `${area.data.city}, ${area.data.state}`;
                      const inner = (
                        <>
                          <span class="area-pin" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                              <circle cx="12" cy="10" r="3" />
                            </svg>
                          </span>
                          <span class="theme-text leading-tight">{label}</span>
                        </>
                      );
                      return (
                        <li>
                          {hrefBase ? (
                            <a
                              href={`${hrefBase}/${area.data.slug}`}
                              aria-label={label}
                              class="area-item area-link"
                            >
                              {inner}
                            </a>
                          ) : (
                            <span class="area-item">{inner}</span>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                </AccordionContent>
              </AccordionItem>
            ))}
          </Accordion>
        </div>

        {/* Optional CTA */}
        {data?.cta && (
          <div class="flex justify-center mt-10">
            <a
              href={data.cta.href}
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold text-sm transition-colors bg-primary text-primary-foreground hover:opacity-90"
            >
              {data.cta.label}
            </a>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .area-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
    text-decoration: none;
  }
  .area-link {
    transition: color 0.2s ease;
  }
  .area-link:hover .theme-text {
    color: var(--theme-accent);
  }
  .area-pin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--theme-accent);
  }
  .area-pin svg {
    width: 0.9rem;
    height: 0.9rem;
  }
</style>
