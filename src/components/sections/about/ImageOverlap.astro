---
import type { Eyebrow, SectionCTA, ImageRef } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";
import SmartImage from "@/components/media/SmartImage.astro";

/**
 * about:image-overlap — story copy beside two overlapping images. A large back
 * image anchors the frame while a smaller foreground image overlaps its lower
 * corner for depth. Optional checklist bullets and up to two CTAs sit under the
 * copy. On mobile the images collapse to a simple stack.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    body?: string;
    image?: ImageRef;
    imageBack?: ImageRef;
    bullets?: string[];
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
    ctas?: SectionCTA[];
  };
}

const { theme = "default", data } = Astro.props;

const ctas = (
  data?.ctas?.length ? data.ctas : [data?.cta, data?.secondaryCta].filter(Boolean)
) as SectionCTA[];
const bullets = data?.bullets ?? [];
const hasImages = Boolean(data?.image?.src || data?.imageBack?.src);
---

<section class:list={["about-image-overlap section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      {/* Overlapping images */}
      {hasImages && (
        <div class="overlap-frame order-1 lg:order-none">
          {data?.imageBack?.src && (
            <figure class="overlap-back m-0">
              <SmartImage
                src={data.imageBack.src}
                alt={data.imageBack.alt ?? ""}
                widths={[480, 768]}
                sizes="(min-width: 1024px) 45vw, 90vw"
                class="w-full h-full object-cover"
              />
            </figure>
          )}
          {data?.image?.src && (
            <figure class="overlap-front m-0">
              <SmartImage
                src={data.image.src}
                alt={data.image.alt ?? ""}
                widths={[320, 512]}
                sizes="(min-width: 1024px) 22vw, 55vw"
                class="w-full h-full object-cover"
              />
            </figure>
          )}
        </div>
      )}

      {/* Story */}
      <div class="flex flex-col gap-5 order-2 lg:order-none">
        {data?.eyebrow &&
          (data.eyebrow.variant === "badge" ? (
            <Badge class="uppercase tracking-widest text-xs self-start">
              {data.eyebrow.text}
            </Badge>
          ) : (
            <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
              {data.eyebrow.text}
            </span>
          ))}

        {data?.heading && (
          <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
            {data.heading}
          </h2>
        )}

        {data?.subheading && (
          <p class="theme-text-muted text-lg leading-relaxed m-0">
            {data.subheading}
          </p>
        )}

        {data?.body && (
          <p class="theme-text-muted text-base leading-relaxed m-0">
            {data.body}
          </p>
        )}

        {bullets.length > 0 && (
          <ul class="flex flex-col gap-sm list-none m-0 p-0 mt-1">
            {bullets.map((b) => (
              <li class="flex items-start gap-sm theme-text">
                <svg
                  class="w-5 h-5 theme-accent shrink-0 mt-0.5"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span class="leading-snug">{b}</span>
              </li>
            ))}
          </ul>
        )}

        {ctas.length > 0 && (
          <div class="flex flex-wrap gap-md mt-2">
            {ctas.map((cta, i) => (
              <Button variant={cta.variant ?? (i === 0 ? "primary" : "outline")} href={cta.href}>
                {cta.label}
              </Button>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .overlap-frame {
    position: relative;
    padding-bottom: 3.5rem;
    padding-right: 3.5rem;
  }

  .overlap-back {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--t-radius);
    border: var(--t-border-width) solid var(--theme-border);
    box-shadow: var(--t-shadow-md);
  }

  .overlap-front {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 52%;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: var(--t-radius);
    border: 4px solid var(--card);
    box-shadow: var(--t-shadow-lg);
  }

  @media (max-width: 640px) {
    .overlap-frame {
      padding-bottom: 0;
      padding-right: 0;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .overlap-front {
      position: static;
      width: 100%;
      aspect-ratio: 4 / 3;
      border-width: var(--t-border-width);
      border-color: var(--theme-border);
    }
  }
</style>
