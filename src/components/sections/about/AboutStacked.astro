---
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    body?: string;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;
---

<section class={`section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    <div class="flex flex-col items-center text-center gap-6 max-w-2xl mx-auto">
      {
        data?.eyebrow && (
          <div>
            {data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            )}
          </div>
        )
      }

      {
        data?.heading && (
          <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
            {data.heading}
          </h2>
        )
      }

      {
        data?.body && (
          <p class="theme-text-muted text-lg leading-relaxed m-0">
            {data.body}
          </p>
        )
      }

      {
        data?.cta && (
          <div class="mt-2">
            <a
              href={data.cta.href}
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold text-sm bg-primary text-primary-foreground hover:opacity-90 transition"
            >
              {data.cta.label}
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>
