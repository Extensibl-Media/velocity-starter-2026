---
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import { Button } from "@/components/starwind/button";

/**
 * about:credentials — a short trust story followed by a horizontal strip of
 * credential / license / certification cards (label + issuer + note). Reassures
 * on legitimacy without leaving the About narrative. Renders a licensed-and-
 * insured badge row that scrolls on small screens.
 */
interface Credential {
  label?: string;
  issuer?: string;
  description?: string;
}

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    body?: string;
    credentials?: Credential[];
    cta?: SectionCTA;
    ctas?: SectionCTA[];
  };
}

const { theme = "default", data } = Astro.props;

const ctas = (
  data?.ctas?.length ? data.ctas : [data?.cta].filter(Boolean)
) as SectionCTA[];
const credentials = (data?.credentials ?? []).filter((c) => c?.label);
const hasHeader = Boolean(data?.eyebrow || data?.heading || data?.subheading || data?.body);
---

{
  (hasHeader || credentials.length > 0) && (
    <section class:list={["about-credentials section-wrapper section-py", `theme-${theme}`]}>
      <div class="section-container">
        {hasHeader && (
          <div class="flex flex-col gap-4 max-w-3xl mb-10">
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs self-start">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                  {data.eyebrow.text}
                </span>
              ))}

            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}

            {data?.subheading && (
              <p class="theme-text-muted text-lg leading-relaxed m-0">
                {data.subheading}
              </p>
            )}

            {data?.body && (
              <p class="theme-text-muted text-base leading-relaxed m-0">
                {data.body}
              </p>
            )}
          </div>
        )}

        {credentials.length > 0 && (
          <ul class="credentials-strip list-none m-0 p-0">
            {credentials.map((cred) => (
              <li class="credential-card">
                <span class="credential-seal" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                </span>
                <div class="flex flex-col gap-1 min-w-0">
                  <span class="theme-heading font-semibold leading-snug">
                    {cred.label}
                  </span>
                  {cred.issuer && (
                    <span class="theme-accent text-sm font-medium">
                      {cred.issuer}
                    </span>
                  )}
                  {cred.description && (
                    <span class="theme-text-muted text-sm leading-relaxed">
                      {cred.description}
                    </span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )}

        {ctas.length > 0 && (
          <div class="flex flex-wrap gap-4 mt-10">
            {ctas.map((cta, i) => (
              <Button variant={cta.variant ?? (i === 0 ? "primary" : "outline")} href={cta.href}>
                {cta.label}
              </Button>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .credentials-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .credential-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    box-shadow: var(--t-shadow-sm);
  }

  .credential-seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: 999px;
    color: var(--theme-accent);
    background: color-mix(in srgb, var(--theme-accent) 12%, transparent);
  }

  .credential-seal svg {
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
