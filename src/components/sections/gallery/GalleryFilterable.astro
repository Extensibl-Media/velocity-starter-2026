---
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import SmartImage from "@/components/media/SmartImage.astro";

/**
 * gallery:filterable — a photo grid with category filter buttons. Categories
 * are collected from the images; "All" plus one button per category toggle
 * item visibility. Each instance filters independently.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    images?: { src: string; alt?: string; caption?: string; category?: string }[];
  };
}

const { theme = "default", data } = Astro.props;
const images = data?.images ?? [];
const categories = [...new Set(images.map((img) => img.category).filter((c): c is string => !!c))];
---

{
  images.length > 0 && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Header */}
        <div class="flex flex-col items-center text-center gap-3 mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>
          )}
        </div>

        <div class="gallery-filter" data-gallery-filter>
          {/* Filter buttons */}
          {categories.length > 0 && (
            <div class="flex flex-wrap justify-center gap-2 mb-8" role="group" aria-label="Filter by category">
              <button
                type="button"
                class="gallery-filter-btn bg-primary text-primary-foreground rounded-full px-4 py-1.5 text-sm font-medium cursor-pointer"
                data-filter="all"
                aria-pressed="true"
              >
                All
              </button>
              {categories.map((cat) => (
                <button
                  type="button"
                  class="gallery-filter-btn border theme-border rounded-full px-4 py-1.5 text-sm font-medium cursor-pointer"
                  data-filter={cat}
                  aria-pressed="false"
                >
                  {cat}
                </button>
              ))}
            </div>
          )}

          {/* Grid */}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {images.map((img) => (
              <figure class="gallery-filter-item m-0" data-cat={img.category ?? ""}>
                <div class="gallery-filter-frame">
                  <SmartImage
                    src={img.src}
                    alt={img.alt ?? ""}
                    widths={[400, 600, 800]}
                    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    class="gallery-filter-img"
                  />
                </div>
                {img.caption && (
                  <figcaption class="theme-text-subtle text-sm mt-2 text-center">{img.caption}</figcaption>
                )}
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .gallery-filter-frame {
    border-radius: var(--radius);
    overflow: hidden;
  }
  .gallery-filter-item :global(.gallery-filter-img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .gallery-filter-item:hover :global(.gallery-filter-img) {
    transform: scale(1.04);
  }
</style>

<script>
  function initFilter(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = "1";
    const buttons = root.querySelectorAll<HTMLButtonElement>(".gallery-filter-btn");
    const items = root.querySelectorAll<HTMLElement>("[data-cat]");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter") ?? "all";

        buttons.forEach((b) => {
          const isActive = b === btn;
          b.setAttribute("aria-pressed", isActive ? "true" : "false");
          b.classList.toggle("bg-primary", isActive);
          b.classList.toggle("text-primary-foreground", isActive);
          b.classList.toggle("border", !isActive);
          b.classList.toggle("theme-border", !isActive);
        });

        items.forEach((item) => {
          const cat = item.getAttribute("data-cat") ?? "";
          item.hidden = filter !== "all" && cat !== filter;
        });
      });
    });
  }

  function initAllFilter() {
    document.querySelectorAll<HTMLElement>("[data-gallery-filter]").forEach(initFilter);
  }
  initAllFilter();
  document.addEventListener("astro:after-swap", initAllFilter);
</script>
