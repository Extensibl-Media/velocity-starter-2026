---
import type { Eyebrow, FeatureItem, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    items?: FeatureItem[];
    ctas?: SectionCTA[];
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const items = data?.items ?? [];
const ctas = (data?.ctas?.length
  ? data.ctas
  : [data?.cta, data?.secondaryCta].filter(Boolean)) as SectionCTA[];
---

<section
  class:list={[
    "comparison-apart section-wrapper section-py",
    `theme-${theme}`,
  ]}
>
  <div class="section-container">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] items-start">
      {/* Left: header + CTA */}
      <div class="flex flex-col gap-md lg:sticky lg:top-24">
        {
          data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs w-fit">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="theme-accent text-sm font-semibold uppercase tracking-widest">
                {data.eyebrow.text}
              </span>
            ))
        }
        {
          data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )
        }
        {
          data?.subheading && (
            <p class="theme-text-muted text-lg m-0">{data.subheading}</p>
          )
        }
        {
          ctas.length > 0 && (
            <div class="flex flex-wrap gap-sm mt-2">
              {ctas.map((cta, i) => (
                <Button
                  href={cta.href}
                  variant={cta.variant ?? (i === 0 ? "primary" : "outline")}
                >
                  {cta.label}
                </Button>
              ))}
            </div>
          )
        }
      </div>

      {/* Right: checklist of positives */}
      <ul class="apart-list">
        {
          items.map((item) => (
            <li class="apart-item surface-base">
              <span class="apart-check">
                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="var(--theme-accent, var(--color-primary))"
                  stroke-width="2.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  role="img"
                  aria-label="Yes"
                >
                  <path d="M4 10.5l4 4 8-9" />
                </svg>
              </span>
              <div class="flex flex-col gap-1">
                <h3 class="theme-heading text-base font-bold m-0">
                  {item.title}
                </h3>
                {item.body && (
                  <p class="theme-text-muted text-sm m-0">{item.body}</p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .apart-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .apart-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    padding: 1.15rem 1.25rem;
    box-shadow: var(--t-shadow-sm);
  }
  .apart-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: color-mix(
      in srgb,
      var(--theme-accent, var(--color-primary)) 12%,
      transparent
    );
  }
  .apart-check svg {
    width: 1.15rem;
    height: 1.15rem;
  }
</style>
