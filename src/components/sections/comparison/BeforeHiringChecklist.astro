---
import type { Eyebrow, FeatureItem, SectionCTA } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import { Button } from "@/components/starwind/button";
import { getBusinessData } from "@/lib/utils";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    usLabel?: string;
    assuranceTitle?: string;
    assuranceBody?: string;
    items?: FeatureItem[];
    ctas?: SectionCTA[];
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const business = await getBusinessData();
const usLabel = data?.usLabel ?? business?.businessName ?? "Peak Roofing Co.";
const items = data?.items ?? [];
const ctas = (data?.ctas?.length
  ? data.ctas
  : [data?.cta, data?.secondaryCta].filter(Boolean)) as SectionCTA[];
---

<section
  class:list={[
    "comparison-checklist section-wrapper section-py",
    `theme-${theme}`,
  ]}
>
  <div class="section-container">
    {
      (data?.eyebrow || data?.heading || data?.subheading) && (
        <div class="flex flex-col items-center text-center gap-3 mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="theme-accent text-sm font-semibold uppercase tracking-widest">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>
      )
    }

    <div class="checklist-card surface-base max-w-3xl mx-auto">
      <div class="checklist-card-head">
        <span class="theme-accent text-xs font-bold uppercase tracking-widest">
          Where {usLabel} stands
        </span>
        {
          data?.assuranceTitle && (
            <h3 class="theme-heading text-xl font-bold m-0 mt-1">
              {data.assuranceTitle}
            </h3>
          )
        }
        {
          data?.assuranceBody && (
            <p class="theme-text-muted text-sm m-0 mt-2">
              {data.assuranceBody}
            </p>
          )
        }
      </div>

      <ol class="checklist-list">
        {
          items.map((item, i) => (
            <li class="checklist-item">
              <span class="checklist-num theme-accent">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="flex flex-col gap-1 flex-1">
                <div class="flex items-start justify-between gap-3">
                  <h4 class="theme-heading text-base font-bold m-0">
                    {item.title}
                  </h4>
                  <span class="checklist-badge">
                    <svg
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="var(--theme-accent, var(--color-primary))"
                      stroke-width="2.25"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      role="img"
                      aria-label="We meet this"
                    >
                      <path d="M4 10.5l4 4 8-9" />
                    </svg>
                    <span class="theme-accent text-xs font-semibold">
                      We do
                    </span>
                  </span>
                </div>
                {item.body && (
                  <p class="theme-text-muted text-sm m-0">{item.body}</p>
                )}
              </div>
            </li>
          ))
        }
      </ol>

      {
        ctas.length > 0 && (
          <div class="checklist-foot">
            {ctas.map((cta, i) => (
              <Button
                href={cta.href}
                variant={cta.variant ?? (i === 0 ? "primary" : "outline")}
              >
                {cta.label}
              </Button>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .checklist-card {
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    box-shadow: var(--t-shadow-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .checklist-card-head {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--theme-border);
  }
  .checklist-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .checklist-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .checklist-num {
    font-size: 0.95rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    padding-top: 0.1rem;
    flex-shrink: 0;
  }
  .checklist-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--theme-border);
    background: color-mix(
      in srgb,
      var(--theme-accent, var(--color-primary)) 10%,
      transparent
    );
  }
  .checklist-badge svg {
    width: 0.9rem;
    height: 0.9rem;
  }
  .checklist-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--theme-border);
  }
</style>
