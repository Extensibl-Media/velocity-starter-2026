---
import { getCollection } from "astro:content";
import type { Eyebrow, FormConfig } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import FormRenderer from "@/components/forms/FormRenderer.astro";

/**
 * contact:form-trust — lead form beside a social-proof trust panel. The panel
 * stacks an aggregate star rating (derived from the `reviews` collection), up to
 * two featured review quotes, and an author-editable list of guarantee points.
 * The form renders via FormRenderer and sits on its own `.surface-base` card so
 * inputs stay readable even on a dark/colored section.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    trustPoints?: string[];
    form?: FormConfig;
  };
}

const { theme = "default", data } = Astro.props;
const services = await getCollection("services");
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);

const reviews = await getCollection("reviews");
const reviewCount = reviews.length;
const avgRating =
  reviewCount > 0
    ? reviews.reduce((sum, r) => sum + r.data.rating, 0) / reviewCount
    : 0;
const roundedStars = Math.round(avgRating);
const featuredQuotes = reviews.filter((r) => r.data.featured).slice(0, 2);
const trustPoints = data?.trustPoints ?? [];
---

<section class:list={["contact-form-trust section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    {/* Header */}
    <div class="flex flex-col items-center text-center gap-3 mb-12">
      {
        data?.eyebrow && (
          <div>
            {data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
            ) : (
              <span class="theme-accent text-sm font-semibold uppercase tracking-widest">
                {data.eyebrow.text}
              </span>
            )}
          </div>
        )
      }
      {data?.heading && <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>}
      {data?.subheading && <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      {/* Trust panel */}
      <div class="flex flex-col gap-8 lg:pt-2">
        {
          reviewCount > 0 && (
            <div class="flex flex-col gap-2">
              <div class="flex items-center gap-3">
                <div class="flex items-center gap-1" aria-hidden="true">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <svg
                      viewBox="0 0 24 24"
                      class="star"
                      fill={roundedStars > i ? "currentColor" : "none"}
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                  ))}
                </div>
                <span class="theme-heading text-lg font-bold m-0">{avgRating.toFixed(1)}</span>
              </div>
              <p class="theme-text-muted text-sm m-0">
                Rated by {reviewCount} local {reviewCount === 1 ? "customer" : "customers"}
              </p>
            </div>
          )
        }

        {
          featuredQuotes.length > 0 && (
            <div class="flex flex-col gap-4">
              {featuredQuotes.map((r) => (
                <figure class="surface-base quote-card m-0">
                  <blockquote class="theme-text text-base leading-relaxed m-0">
                    &ldquo;{r.data.body}&rdquo;
                  </blockquote>
                  <figcaption class="theme-text-subtle text-sm font-semibold mt-3">
                    — {r.data.author}
                    {r.data.location ? `, ${r.data.location}` : ""}
                  </figcaption>
                </figure>
              ))}
            </div>
          )
        }

        {
          trustPoints.length > 0 && (
            <ul class="flex flex-col gap-2.5 m-0 p-0 list-none">
              {trustPoints.map((point) => (
                <li class="flex items-start gap-3">
                  <span class="check-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </span>
                  <span class="theme-text text-base">{point}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {/* Form */}
      <div class="w-full">
        <FormRenderer form={data?.form} services={sortedServices} />
      </div>
    </div>
  </div>
</section>

<style>
  .star {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--theme-accent);
  }
  .quote-card {
    padding: 1.25rem 1.5rem;
  }
  .check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    margin-top: 0.1rem;
    background: color-mix(in srgb, var(--theme-accent) 12%, transparent);
    color: var(--theme-accent);
  }
  .check-icon svg {
    width: 0.9rem;
    height: 0.9rem;
  }
</style>
