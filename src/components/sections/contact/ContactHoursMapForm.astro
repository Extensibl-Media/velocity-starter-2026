---
import { getHoursSettings, getServices } from "@/lib/content";
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow, FormConfig } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import FormRenderer from "@/components/forms/FormRenderer.astro";

/**
 * contact:hours-map-form — a three-column "everything to reach us" section:
 * business-hours table, an embedded map, and the lead form. On smaller screens
 * the columns stack. Hours come from `hoursSettings`, the map from an authored
 * `mapEmbedUrl` (falling back to a Google embed of the `generalSettings`
 * address), and the form renders via FormRenderer on its own surface card.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    mapEmbedUrl?: string;
    form?: FormConfig;
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();
const services = await getServices();
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);

const hoursEntries = await getHoursSettings();
const hours = hoursEntries[0]?.data.hours ?? [];

const fullAddress = [
  business.address,
  [business.city, business.state].filter(Boolean).join(", "),
  business.zip,
]
  .filter(Boolean)
  .join(" ");
const mapSrc =
  data?.mapEmbedUrl ??
  (fullAddress
    ? `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`
    : null);
---

<section class:list={["contact-hours-map-form section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    {/* Header */}
    <div class="flex flex-col items-center text-center gap-sm mb-12">
      {
        data?.eyebrow && (
          <div>
            {data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
            ) : (
              <span class="theme-accent text-sm font-semibold uppercase tracking-widest">
                {data.eyebrow.text}
              </span>
            )}
          </div>
        )
      }
      {data?.heading && <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>}
      {data?.subheading && <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-xl items-start">
      {/* Hours */}
      <div class="flex flex-col gap-md">
        {
          hours.length > 0 ? (
            <div class="rounded-xl border theme-border overflow-hidden">
              <div class="flex items-center gap-sm px-5 py-4 border-b theme-border">
                <span class="contact-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 6v6l4 2" />
                  </svg>
                </span>
                <h3 class="theme-heading text-sm font-semibold uppercase tracking-widest m-0">Hours</h3>
              </div>
              <dl class="flex flex-col m-0">
                {hours.map((row: any, i: number) => (
                  <div
                    class:list={[
                      "flex items-center justify-between gap-md px-5 py-3",
                      i > 0 && "border-t theme-border",
                    ]}
                  >
                    <dt class="theme-text-muted text-sm m-0">{row.day}</dt>
                    <dd class="theme-text text-sm font-medium tabular-nums m-0">
                      {row.closedAllDay ? "Closed" : `${row.open} – ${row.close}`}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          ) : (
            <p class="theme-text-muted m-0">Hours available by phone.</p>
          )
        }
      </div>

      {/* Map */}
      {
        mapSrc ? (
          <div class="map-box overflow-hidden rounded-xl border theme-border bg-bg-muted min-h-[18rem]">
            <iframe
              src={mapSrc}
              title={`Map to ${business.businessName ?? "our location"}`}
              width="100%"
              height="100%"
              style="border:0; min-height: 18rem;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            />
          </div>
        ) : (
          <div class="flex items-center justify-center rounded-xl border theme-border bg-bg-muted min-h-[18rem] p-6 text-center">
            <p class="theme-text-muted m-0">Map location coming soon.</p>
          </div>
        )
      }

      {/* Form */}
      <div class="w-full">
        <FormRenderer form={data?.form} services={sortedServices} />
      </div>
    </div>
  </div>
</section>

<style>
  .map-box iframe {
    display: block;
    width: 100%;
    height: 100%;
  }
  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--theme-accent) 10%, transparent);
    color: var(--theme-accent);
  }
  .contact-icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
