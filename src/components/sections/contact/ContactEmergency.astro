---
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import { Button } from "@/components/starwind/button";

/**
 * contact:emergency — a single highlighted "urgent help" panel. A bold pulse
 * icon, urgency copy, a very large tappable phone number, an optional list of
 * assurance points (24/7, same-day, etc.), and a secondary "schedule instead"
 * CTA. The panel is a raised `.surface-base` card so it reads clearly on a
 * dark/colored section. Phone falls back to the `generalSettings` singleton.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    phone?: string;
    points?: string[];
    cta?: SectionCTA;
  };
}

const { theme = "primary", data } = Astro.props;
const business = await getBusinessData();

const phone = data?.phone ?? business.phone;
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, "")}` : null;
const points = data?.points ?? [];
const cta = data?.cta;
---

<section class:list={["contact-emergency section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    <div class="surface-base emergency-panel mx-auto max-w-3xl text-center">
      <span class="pulse-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
      </span>

      {
        data?.eyebrow && (
          <div class="mt-4">
            {data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
            ) : (
              <span class="theme-accent text-sm font-semibold uppercase tracking-widest">
                {data.eyebrow.text}
              </span>
            )}
          </div>
        )
      }
      {data?.heading && <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0 mt-3">{data.heading}</h2>}
      {data?.subheading && <p class="theme-text-muted text-lg m-0 mt-3 max-w-xl mx-auto">{data.subheading}</p>}

      {
        telHref && (
          <a
            href={telHref}
            class="emergency-phone theme-heading no-underline mt-6"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span>{phone}</span>
          </a>
        )
      }

      {
        points.length > 0 && (
          <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 m-0 mt-6 p-0 list-none">
            {points.map((point) => (
              <li class="flex items-center gap-2 theme-text-muted text-sm font-medium">
                <span class="check-dot" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </span>
                {point}
              </li>
            ))}
          </ul>
        )
      }

      {
        cta && (
          <div class="mt-8">
            <Button variant={cta.variant ?? "outline"} href={cta.href}>
              {cta.label}
            </Button>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .emergency-panel {
    padding: 2.5rem 1.5rem;
    box-shadow: var(--t-shadow-lg);
  }
  @media (min-width: 768px) {
    .emergency-panel {
      padding: 3.5rem 3rem;
    }
  }
  .pulse-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--theme-accent) 12%, transparent);
    color: var(--theme-accent);
  }
  .pulse-icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }
  .emergency-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 800;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.1;
    transition: color 0.15s ease;
  }
  .emergency-phone:hover {
    color: var(--theme-accent);
  }
  .emergency-phone svg {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--theme-accent);
    flex-shrink: 0;
  }
  .check-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--theme-accent);
  }
  .check-dot svg {
    width: 0.85rem;
    height: 0.85rem;
  }
</style>
