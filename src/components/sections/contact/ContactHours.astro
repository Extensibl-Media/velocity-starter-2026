---
import { getCollection } from "astro:content";
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import { Button } from "@/components/starwind/button";

/**
 * contact:hours — an hours-focused contact section. A prominent business-hours
 * table sits beside a compact NAP (name/address/phone) block with a "Call Now"
 * button. Hours come from the `hoursSettings` singleton and business details
 * from the `generalSettings` singleton so everything stays in sync.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();

const h = await getCollection("hoursSettings");
const hours = h[0]?.data.hours ?? [];

const fullAddress = [
  business.address,
  [business.city, business.state].filter(Boolean).join(", "),
  business.zip,
]
  .filter(Boolean)
  .join(" ");
const telHref = business.phone ? `tel:${business.phone.replace(/[^\d+]/g, "")}` : null;
---

<section class={`section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    {/* Header */}
    <div class="flex flex-col items-center text-center gap-3 mb-12">
      {
        data?.eyebrow && (
          <div>
            {data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            )}
          </div>
        )
      }
      {data?.heading && <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>}
      {data?.subheading && <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16 items-start">
      {/* Hours table */}
      <div class="lg:col-span-3">
        {
          hours.length > 0 ? (
            <div class="rounded-xl border theme-border overflow-hidden">
              <div class="flex items-center gap-3 px-6 py-4 border-b theme-border">
                <span class="contact-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 6v6l4 2" />
                  </svg>
                </span>
                <h3 class="theme-heading text-sm font-semibold uppercase tracking-widest m-0">Business Hours</h3>
              </div>
              <dl class="flex flex-col m-0">
                {hours.map((row: any, i: number) => (
                  <div
                    class:list={[
                      "flex items-center justify-between gap-4 px-6 py-3.5",
                      i > 0 && "border-t theme-border",
                    ]}
                  >
                    <dt class="theme-text font-medium m-0">{row.day}</dt>
                    <dd class="m-0">
                      {row.closedAllDay ? (
                        <span class="theme-text-subtle font-medium">Closed</span>
                      ) : (
                        <span class="theme-text-muted font-medium tabular-nums">
                          {row.open} – {row.close}
                        </span>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          ) : (
            <p class="theme-text-muted m-0">Hours available by phone.</p>
          )
        }
      </div>

      {/* NAP block */}
      <div class="lg:col-span-2 flex flex-col gap-6">
        {
          business.name && (
            <div>
              <span class="theme-text-subtle text-xs font-semibold uppercase tracking-widest">Find us</span>
              <p class="theme-heading text-xl font-bold m-0 mt-1">{business.name}</p>
            </div>
          )
        }
        {
          telHref && (
            <a href={telHref} class="flex items-start gap-4 no-underline group">
              <span class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
              </span>
              <span class="flex flex-col">
                <span class="theme-text-subtle text-xs font-semibold uppercase tracking-widest">Call us</span>
                <span class="theme-heading text-lg font-semibold group-hover:text-primary transition-colors">
                  {business.phone}
                </span>
              </span>
            </a>
          )
        }
        {
          fullAddress && (
            <div class="flex items-start gap-4">
              <span class="contact-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </span>
              <span class="flex flex-col">
                <span class="theme-text-subtle text-xs font-semibold uppercase tracking-widest">Visit</span>
                <span class="theme-text text-lg">{fullAddress}</span>
              </span>
            </div>
          )
        }
        {
          telHref && (
            <Button variant="primary" href={telHref} class="w-full">
              Call Now
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--theme-accent) 10%, transparent);
    color: var(--theme-accent);
  }
  .contact-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
