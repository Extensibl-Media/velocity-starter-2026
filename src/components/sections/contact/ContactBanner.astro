---
import { getHoursSettings } from "@/lib/content";
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

/**
 * contact:banner — a raised, full-width "call us" banner. Copy sits on the left;
 * a large tappable phone number, an optional today's-hours pill, and a primary
 * CTA sit on the right. A bolder, more prominent alternative to contact:cta,
 * built as one raised `.surface-base` band. Phone comes from `generalSettings`
 * and today's hours from the `hoursSettings` singleton.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    cta?: SectionCTA;
    showHours?: boolean;
  };
}

const { theme = "alt", data } = Astro.props;
const business = await getBusinessData();

const telHref = business.phone ? `tel:${business.phone.replace(/[^\d+]/g, "")}` : null;
const cta = data?.cta;

const showHours = data?.showHours ?? true;
const hoursEntries = showHours ? await getHoursSettings() : [];
const hours = hoursEntries[0]?.data.hours ?? [];
const todayName = new Date().toLocaleDateString("en-US", { weekday: "long" });
const today = hours.find((h: any) => h.day?.toLowerCase() === todayName.toLowerCase());
const todayLabel = today
  ? today.closedAllDay
    ? "Closed today"
    : `Open today ${today.open} – ${today.close}`
  : null;
---

<section class:list={["contact-banner section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    <div class="surface-base banner-panel flex flex-col lg:flex-row lg:items-center gap-xl lg:gap-12">
      {/* Copy */}
      <div class="flex flex-col gap-2.5 lg:flex-1">
        {
          data?.eyebrow && (
            <div>
              {data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
              ) : (
                <span class="theme-accent text-sm font-semibold uppercase tracking-widest">
                  {data.eyebrow.text}
                </span>
              )}
            </div>
          )
        }
        {data?.heading && <h2 class="theme-heading text-2xl lg:text-4xl font-bold m-0">{data.heading}</h2>}
        {data?.subheading && <p class="theme-text-muted text-base lg:text-lg max-w-xl m-0">{data.subheading}</p>}
      </div>

      {/* Actions */}
      <div class="flex flex-col items-start lg:items-end gap-md lg:shrink-0">
        {
          telHref && (
            <a href={telHref} class="banner-phone theme-heading no-underline group">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              <span>{business.phone}</span>
            </a>
          )
        }
        {
          todayLabel && (
            <span class="hours-pill">
              <span class="hours-dot" aria-hidden="true" />
              {todayLabel}
            </span>
          )
        }
        {
          cta && (
            <Button variant={cta.variant ?? "primary"} href={cta.href}>
              {cta.label}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .banner-panel {
    padding: 2rem 1.5rem;
    box-shadow: var(--t-shadow-lg);
  }
  @media (min-width: 1024px) {
    .banner-panel {
      padding: 2.5rem 3rem;
    }
  }
  .banner-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    line-height: 1.1;
    transition: color 0.15s ease;
  }
  .banner-phone:hover {
    color: var(--theme-accent);
  }
  .banner-phone svg {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--theme-accent);
    flex-shrink: 0;
  }
  .hours-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--theme-fg-muted);
    background: color-mix(in srgb, var(--theme-accent) 8%, transparent);
    border: var(--t-border-width, 1px) solid var(--theme-border);
  }
  .hours-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-primary);
    flex-shrink: 0;
  }
</style>
