---
import { getCollection } from "astro:content";
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";

/**
 * contact:cards — a responsive grid (2 cols → 4 cols) of contact METHOD cards.
 * Call / Email / Visit / Hours, each a bordered card with a primary-tinted icon
 * circle, a label, and the value. Actionable cards (Call, Email) are anchors;
 * the Hours card surfaces today's hours. Details pull from the `generalSettings`
 * + `hoursSettings` singletons so they stay in sync.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();

const hoursEntries = await getCollection("hoursSettings");
const hours = hoursEntries[0]?.data.hours ?? [];

const fullAddress = [
  business.address,
  [business.city, business.state].filter(Boolean).join(", "),
  business.zip,
]
  .filter(Boolean)
  .join(" ");
const telHref = business.phone ? `tel:${business.phone.replace(/[^\d+]/g, "")}` : null;

// Surface today's hours on the Hours card.
const todayName = new Date().toLocaleDateString("en-US", { weekday: "long" });
const today = hours.find((h: any) => h.day?.toLowerCase() === todayName.toLowerCase());
const todayHours = today
  ? today.closedAllDay
    ? "Closed today"
    : `${today.open} – ${today.close}`
  : hours.length > 0
    ? "See full hours"
    : null;
---

<section class={`section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    {/* Header */}
    <div class="flex flex-col items-center text-center gap-3 mb-12">
      {
        data?.eyebrow && (
          <div>
            {data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            )}
          </div>
        )
      }
      {data?.heading && <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>}
      {data?.subheading && <p class="theme-text-muted text-lg max-w-2xl m-0">{data.subheading}</p>}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        telHref && (
          <a href={telHref} class="method-card rounded-xl border theme-border bg-background no-underline group">
            <span class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </span>
            <span class="theme-text-subtle text-xs font-semibold uppercase tracking-widest">Call</span>
            <span class="theme-heading text-base font-semibold group-hover:text-primary transition-colors break-words">
              {business.phone}
            </span>
          </a>
        )
      }
      {
        business.email && (
          <a href={`mailto:${business.email}`} class="method-card rounded-xl border theme-border bg-background no-underline group">
            <span class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-10 6L2 7" />
              </svg>
            </span>
            <span class="theme-text-subtle text-xs font-semibold uppercase tracking-widest">Email</span>
            <span class="theme-heading text-base font-semibold group-hover:text-primary transition-colors break-words">
              {business.email}
            </span>
          </a>
        )
      }
      {
        fullAddress && (
          <div class="method-card rounded-xl border theme-border bg-background">
            <span class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            <span class="theme-text-subtle text-xs font-semibold uppercase tracking-widest">Visit</span>
            <span class="theme-text text-base">{fullAddress}</span>
          </div>
        )
      }
      {
        todayHours && (
          <div class="method-card rounded-xl border theme-border bg-background">
            <span class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 6v6l4 2" />
              </svg>
            </span>
            <span class="theme-text-subtle text-xs font-semibold uppercase tracking-widest">Hours</span>
            <span class="theme-heading text-base font-semibold">{todayHours}</span>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .method-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .method-card:hover {
    box-shadow: var(--t-shadow-md);
    transform: translateY(-2px);
  }
  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--theme-accent) 10%, transparent);
    color: var(--theme-accent);
    margin-bottom: 0.25rem;
  }
  .contact-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
