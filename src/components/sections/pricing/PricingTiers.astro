---
import type { Eyebrow, PricingPlan } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    plans?: PricingPlan[];
  };
}

const { theme = "default", data } = Astro.props;

const plans = data?.plans ?? [];
---

{
  plans.length > 0 && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        <div class="flex flex-col items-center text-center gap-sm mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>

        {/* Plans */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-lg items-stretch">
          {plans.map((plan) => (
            <div
              class:list={[
                "pricing-card relative flex flex-col gap-lg p-6 rounded-xl border theme-border bg-background",
                plan.highlighted && "is-highlighted",
              ]}
            >
              {plan.highlighted && (
                <span class="pricing-badge absolute -top-3 left-1/2 -translate-x-1/2 text-xs font-semibold px-3 py-1 rounded-full whitespace-nowrap">
                  Most Popular
                </span>
              )}

              {/* Plan header */}
              <div class="flex flex-col gap-sm">
                <h3 class="theme-heading text-lg font-semibold m-0">
                  {plan.name}
                </h3>
                <div class="flex items-baseline gap-1">
                  <span class="theme-heading text-4xl font-bold leading-none">
                    {plan.price}
                  </span>
                  {plan.period && (
                    <span class="theme-text-muted text-sm font-medium">
                      {plan.period}
                    </span>
                  )}
                </div>
                {plan.description && (
                  <p class="theme-text-muted text-sm leading-relaxed m-0">
                    {plan.description}
                  </p>
                )}
              </div>

              {/* Features */}
              {plan.features && plan.features.length > 0 && (
                <ul class="flex flex-col gap-sm m-0 p-0 list-none flex-1">
                  {plan.features.map((feature) => (
                    <li class="flex items-start gap-2.5 text-sm theme-text">
                      <svg
                        class="w-4 h-4 shrink-0 mt-0.5"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="var(--color-primary)"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              )}

              {/* CTA */}
              {plan.cta && (
                <div class="mt-auto">
                  <Button
                    variant={plan.cta.variant ?? "primary"}
                    href={plan.cta.href}
                    class="w-full"
                  >
                    {plan.cta.label}
                  </Button>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .pricing-card.is-highlighted {
    border-color: var(--theme-accent);
    box-shadow: var(--t-shadow-md);
  }

  .pricing-badge {
    background: var(--color-primary);
    color: var(--color-fg-on-primary);
  }
</style>
