---
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

interface PriceCard {
  title: string;
  price: string;
  description?: string;
  cta?: SectionCTA;
}

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    items?: PriceCard[];
  };
}

const { theme = "default", data } = Astro.props;

const items = data?.items ?? [];
---

{
  items.length > 0 && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        <div class="flex flex-col items-center text-center gap-sm mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>

        {/* Price cards */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-lg items-stretch">
          {items.map((item) => (
            <div class="flex flex-col gap-sm p-6 rounded-xl border theme-border bg-background text-center">
              <h3 class="theme-heading text-lg font-semibold m-0">
                {item.title}
              </h3>
              <span class="text-primary text-4xl font-bold leading-none">
                {item.price}
              </span>
              {item.description && (
                <p class="theme-text-muted text-sm leading-relaxed m-0">
                  {item.description}
                </p>
              )}
              {item.cta && (
                <div class="mt-auto pt-3">
                  <Button
                    variant={item.cta.variant ?? "ghost"}
                    href={item.cta.href}
                    class="w-full"
                  >
                    {item.cta.label}
                  </Button>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
