---
import type { Eyebrow, PricingPlan, SectionCTA } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import { Button } from "@/components/starwind/button";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    plans?: PricingPlan[];
    footnote?: string;
    secondaryCta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const plans = data?.plans ?? [];
---

{
  plans.length > 0 && (
    <section
      class:list={[
        "pricing-budget-bands section-wrapper section-py",
        `theme-${theme}`,
      ]}
    >
      <div class="section-container">
        {/* Section header */}
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-3 mb-12">
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="theme-accent text-sm font-semibold uppercase tracking-widest">
                  {data.eyebrow.text}
                </span>
              ))}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg max-w-2xl m-0">
                {data.subheading}
              </p>
            )}
          </div>
        )}

        {/* Good / better / best — stacked full-width bands */}
        <div class="flex flex-col gap-4 max-w-4xl mx-auto">
          {plans.map((plan) => (
            <div
              class:list={[
                "band flex flex-col gap-5 p-6 rounded-[var(--t-radius)] lg:flex-row lg:items-center lg:gap-8 lg:p-7",
                plan.highlighted && "is-highlighted",
              ]}
            >
              {/* Price block */}
              <div class="flex flex-col gap-1 lg:w-56 lg:shrink-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="theme-heading text-lg font-semibold m-0">
                    {plan.name}
                  </h3>
                  {plan.highlighted && (
                    <Badge class="uppercase tracking-widest text-[10px]">
                      Best value
                    </Badge>
                  )}
                </div>
                <div class="flex items-baseline gap-1">
                  <span class="theme-heading text-3xl font-bold leading-none">
                    {plan.price}
                  </span>
                  {plan.period && (
                    <span class="theme-text-subtle text-sm">{plan.period}</span>
                  )}
                </div>
                {plan.description && (
                  <p class="theme-text-muted text-sm leading-relaxed m-0">
                    {plan.description}
                  </p>
                )}
              </div>

              {/* Inclusions */}
              {plan.features && plan.features.length > 0 && (
                <ul class="grid grid-cols-1 gap-2 m-0 p-0 list-none flex-1 sm:grid-cols-2">
                  {plan.features.map((feature) => (
                    <li class="flex items-start gap-2 text-sm theme-text">
                      <svg
                        class="w-4 h-4 shrink-0 mt-0.5"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="var(--color-primary)"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              )}

              {/* CTA */}
              {plan.cta && (
                <div class="lg:w-44 lg:shrink-0">
                  <Button
                    variant={plan.cta.variant ?? (plan.highlighted ? "primary" : "outline")}
                    href={plan.cta.href}
                    class="w-full"
                  >
                    {plan.cta.label}
                  </Button>
                </div>
              )}
            </div>
          ))}
        </div>

        {data?.footnote && (
          <p class="theme-text-subtle text-sm text-center max-w-3xl mx-auto mt-6 m-0">
            {data.footnote}
          </p>
        )}

        {data?.secondaryCta && (
          <div class="flex justify-center mt-6">
            <Button
              variant={data.secondaryCta.variant ?? "ghost"}
              href={data.secondaryCta.href}
            >
              {data.secondaryCta.label}
            </Button>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .band {
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    box-shadow: var(--t-shadow-sm);
  }
  .band.is-highlighted {
    border-color: var(--theme-accent);
    box-shadow: var(--t-shadow-md);
  }
</style>
