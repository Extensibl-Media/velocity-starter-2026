---
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import { Button } from "@/components/starwind/button";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    name?: string;
    price?: string;
    period?: string;
    description?: string;
    inclusions?: string[];
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const inclusions = data?.inclusions ?? [];
const hasOffer = !!(data?.name || data?.price || inclusions.length > 0);
---

{
  hasOffer && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-3 mb-12">
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                  {data.eyebrow.text}
                </span>
              ))}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg max-w-2xl m-0">
                {data.subheading}
              </p>
            )}
          </div>
        )}

        {/* Hero offer card */}
        <div class="pricing-single mx-auto max-w-lg flex flex-col items-center text-center gap-6 p-8 lg:p-10 rounded-xl border theme-border bg-background">
          {data?.name && (
            <h3 class="theme-heading text-xl font-semibold m-0">
              {data.name}
            </h3>
          )}

          {data?.price && (
            <div class="flex items-baseline justify-center gap-1">
              <span class="theme-heading text-5xl font-bold leading-none">
                {data.price}
              </span>
              {data.period && (
                <span class="theme-text-muted text-base font-medium">
                  {data.period}
                </span>
              )}
            </div>
          )}

          {data?.description && (
            <p class="theme-text-muted text-base leading-relaxed max-w-md m-0">
              {data.description}
            </p>
          )}

          {inclusions.length > 0 && (
            <ul class="flex flex-col gap-3 m-0 p-0 list-none w-full max-w-sm text-left">
              {inclusions.map((item) => (
                <li class="flex items-start gap-2.5 text-sm theme-text">
                  <svg
                    class="w-5 h-5 shrink-0 mt-px"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="var(--color-primary)"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 10.5l4 4 8-9" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )}

          {data?.cta && (
            <Button
              variant={data.cta.variant ?? "primary"}
              href={data.cta.href}
              class="w-full max-w-sm"
            >
              {data.cta.label}
            </Button>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .pricing-single {
    border-color: var(--theme-accent);
    box-shadow: var(--t-shadow-md);
  }
</style>
