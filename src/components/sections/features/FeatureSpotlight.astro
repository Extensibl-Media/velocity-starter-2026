---
import type { Eyebrow, FeatureItem, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

/**
 * feature:spotlight — a numbered feature spotlight. Each feature is a full-width
 * row led by an oversized index numeral, with the title, body, and optional
 * bullets spotlighted beside it. Generous vertical rhythm makes each point land
 * on its own. Distinct from process:numbered (which describes sequential steps).
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    items?: FeatureItem[];
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;
const items = data?.items ?? [];
---

{
  items.length > 0 && (
    <section
      class:list={["feature-spotlight section-wrapper section-py", `theme-${theme}`]}
    >
      <div class="section-container">
        {/* Section header */}
        <div class="flex flex-col gap-sm mb-12 max-w-2xl">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <div>
                <Badge class="uppercase tracking-widest text-xs">
                  {data.eyebrow.text}
                </Badge>
              </div>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg leading-relaxed m-0">
              {data.subheading}
            </p>
          )}
        </div>

        {/* Numbered spotlight rows */}
        <div class="flex flex-col">
          {items.map((item, i) => (
            <div
              class:list={[
                "spotlight-row grid grid-cols-1 md:grid-cols-[auto_minmax(0,1fr)] gap-5 md:gap-10 py-8 md:py-10",
                i > 0 && "border-t theme-border",
              ]}
            >
              <span class="spotlight-num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="flex flex-col gap-sm">
                <h3 class="theme-heading text-xl lg:text-2xl font-bold m-0">
                  {item.title}
                </h3>
                {item.body && (
                  <p class="theme-text-muted text-base leading-relaxed m-0 max-w-2xl">
                    {item.body}
                  </p>
                )}
                {item.bullets && item.bullets.length > 0 && (
                  <ul class="flex flex-wrap gap-x-xl gap-y-xs m-0 p-0 list-none mt-1">
                    {item.bullets.map((bullet) => (
                      <li class="flex items-start gap-xs theme-text text-sm leading-relaxed">
                        <svg
                          class="spotlight-check shrink-0"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M20 6L9 17l-5-5" />
                        </svg>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))}
        </div>

        {data?.cta && (
          <div class="mt-12">
            <Button variant={data.cta.variant ?? "primary"} href={data.cta.href}>
              {data.cta.label}
            </Button>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .spotlight-num {
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    font-weight: 800;
    line-height: 1;
    color: var(--theme-accent);
    opacity: 0.85;
    font-variant-numeric: tabular-nums;
  }

  .spotlight-check {
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.15rem;
    color: var(--theme-accent);
  }
</style>
