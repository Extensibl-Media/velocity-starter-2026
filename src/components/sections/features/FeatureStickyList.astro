---
import type { Eyebrow, FeatureItem, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

/**
 * feature:sticky-list — a two-column layout where the heading block pins to the
 * viewport (CSS `position: sticky`, no JS) on the left while a tall list of
 * feature items scrolls past on the right. Stacks to a single column on mobile
 * with the heading first. Great for long feature narratives.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    items?: FeatureItem[];
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
    ctas?: SectionCTA[];
  };
}

const { theme = "default", data } = Astro.props;
const items = data?.items ?? [];
const ctas = (
  data?.ctas?.length ? data.ctas : [data?.cta, data?.secondaryCta].filter(Boolean)
) as SectionCTA[];

const iconPaths: Record<string, string> = {
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>',
  star: '<path d="M12 3l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 18.8 6.2 21.9l1.1-6.5L2.6 9.8l6.5-.9L12 3z"/>',
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-6h6v6"/>',
  award: '<circle cx="12" cy="9" r="6"/><path d="M8.5 13.5 7 22l5-3 5 3-1.5-8.5"/>',
  wrench: '<path d="M14.5 6.5a4 4 0 0 0-5 5L3 18l3 3 6.5-6.5a4 4 0 0 0 5-5l-2.5 2.5-2-2 2.5-2.5z"/>',
  droplet: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>',
  bolt: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/>',
  dollar: '<path d="M12 2v20"/><path d="M17 6.5C17 4.6 14.8 3.5 12 3.5S7 4.6 7 6.5 9.2 9.5 12 9.5s5 1.1 5 3-2.2 3-5 3-5-1.1-5-3"/>',
  check:
    '<circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>',
};
---

{
  items.length > 0 && (
    <section
      class:list={[
        "feature-sticky-list section-wrapper section-py",
        `theme-${theme}`,
      ]}
    >
      <div class="section-container">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-10 lg:gap-16 items-start">
          {/* Sticky heading column */}
          <div class="sticky-head flex flex-col gap-5 lg:sticky lg:top-24 self-start">
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs self-start">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                  {data.eyebrow.text}
                </span>
              ))}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg leading-relaxed m-0">
                {data.subheading}
              </p>
            )}
            {ctas.length > 0 && (
              <div class="flex flex-wrap items-center gap-md mt-2">
                {ctas.map((cta, i) => (
                  <Button
                    variant={cta.variant ?? (i === 0 ? "primary" : "outline")}
                    href={cta.href}
                  >
                    {cta.label}
                  </Button>
                ))}
              </div>
            )}
          </div>

          {/* Scrolling feature list */}
          <ul class="flex flex-col gap-0 list-none m-0 p-0">
            {items.map((item, i) => (
              <li
                class:list={[
                  "flex items-start gap-5 py-6",
                  i > 0 && "border-t theme-border",
                ]}
              >
                <span class="sticky-num" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="sticky-icon" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <Fragment
                      set:html={iconPaths[item.icon ?? ""] ?? iconPaths.check}
                    />
                  </svg>
                </span>
                <div class="flex flex-col gap-1.5">
                  <h3 class="theme-heading text-lg font-semibold m-0">
                    {item.title}
                  </h3>
                  {item.body && (
                    <p class="theme-text-muted text-sm leading-relaxed m-0">
                      {item.body}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}

<style>
  .sticky-num {
    flex-shrink: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 2.5rem;
    color: var(--theme-accent);
    opacity: 0.7;
  }

  .sticky-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--theme-accent) 14%, transparent);
    color: var(--theme-accent);
  }

  .sticky-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }
</style>
