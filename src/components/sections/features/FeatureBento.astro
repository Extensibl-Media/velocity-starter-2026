---
import type { Eyebrow, FeatureItem } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

/**
 * feature:bento — an asymmetric "bento" grid of feature tiles. Rows alternate a
 * wide + narrow rhythm (4/2 then 2/4 across a 6-col grid) so no two rows look
 * the same, and the first tile is emphasized as the marquee cell. Robust for any
 * item count; collapses to a single column on mobile.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    items?: FeatureItem[];
  };
}

const { theme = "default", data } = Astro.props;
const items = data?.items ?? [];

const iconPaths: Record<string, string> = {
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>',
  star: '<path d="M12 3l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 18.8 6.2 21.9l1.1-6.5L2.6 9.8l6.5-.9L12 3z"/>',
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-6h6v6"/>',
  award: '<circle cx="12" cy="9" r="6"/><path d="M8.5 13.5 7 22l5-3 5 3-1.5-8.5"/>',
  wrench: '<path d="M14.5 6.5a4 4 0 0 0-5 5L3 18l3 3 6.5-6.5a4 4 0 0 0 5-5l-2.5 2.5-2-2 2.5-2.5z"/>',
  droplet: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>',
  bolt: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/>',
  dollar: '<path d="M12 2v20"/><path d="M17 6.5C17 4.6 14.8 3.5 12 3.5S7 4.6 7 6.5 9.2 9.5 12 9.5s5 1.1 5 3-2.2 3-5 3-5-1.1-5-3"/>',
  check:
    '<circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>',
};

const spanFor = (i: number) =>
  i % 4 === 0 || i % 4 === 3 ? "md:col-span-4" : "md:col-span-2";
const isWide = (i: number) => i % 4 === 0 || i % 4 === 3;
---

{
  items.length > 0 && (
    <section
      class:list={["feature-bento section-wrapper section-py", `theme-${theme}`]}
    >
      <div class="section-container">
        {/* Section header */}
        <div class="flex flex-col items-center text-center gap-sm mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>

        {/* Bento grid */}
        <div class="grid grid-cols-1 md:grid-cols-6 gap-5 auto-rows-fr">
          {items.map((item, i) => (
            <div
              class:list={[
                "bento-tile flex flex-col gap-md p-6 lg:p-7",
                spanFor(i),
                i === 0 && "bento-tile--feature",
              ]}
            >
              <span class="bento-icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <Fragment
                    set:html={iconPaths[item.icon ?? ""] ?? iconPaths.check}
                  />
                </svg>
              </span>
              <h3
                class:list={[
                  "theme-heading font-semibold m-0",
                  isWide(i) ? "text-xl" : "text-lg",
                ]}
              >
                {item.title}
              </h3>
              {item.body && (
                <p class="theme-text-muted text-sm leading-relaxed m-0">
                  {item.body}
                </p>
              )}
              {item.bullets && item.bullets.length > 0 && (
                <ul class="flex flex-col gap-xs m-0 p-0 list-none mt-auto pt-1">
                  {item.bullets.map((bullet) => (
                    <li class="flex items-start gap-xs theme-text text-sm leading-relaxed">
                      <svg
                        class="bento-check shrink-0"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M20 6L9 17l-5-5" />
                      </svg>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .bento-tile {
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    box-shadow: var(--t-shadow-md);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .bento-tile:hover {
    box-shadow: var(--t-shadow-lg);
    transform: translateY(-2px);
  }

  .bento-tile--feature {
    background-color: color-mix(
      in srgb,
      var(--theme-accent) 9%,
      var(--card)
    );
    border-color: color-mix(
      in srgb,
      var(--theme-accent) 30%,
      var(--theme-border)
    );
  }

  .bento-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--theme-accent) 14%, transparent);
    color: var(--theme-accent);
  }

  .bento-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .bento-check {
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.15rem;
    color: var(--theme-accent);
  }
</style>
