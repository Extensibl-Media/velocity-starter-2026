---
import type { Eyebrow, FeatureRow } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import SmartImage from "@/components/media/SmartImage.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    rows?: FeatureRow[];
  };
}

const { theme = "default", data } = Astro.props;

const rows = data?.rows ?? [];
---

{
  rows.length > 0 && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        <div class="flex flex-col items-center text-center gap-3 mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>

        {/* Rows */}
        <div class="flex flex-col gap-16 lg:gap-24">
          {rows.map((row, i) => {
            const imageRight = i % 2 === 0;
            return (
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
                {/* Text */}
                <div
                  class={`flex flex-col gap-4 ${imageRight ? "lg:order-1" : "lg:order-2"}`}
                >
                  <h3 class="theme-heading text-2xl font-bold m-0">
                    {row.heading}
                  </h3>
                  {row.body && (
                    <p class="theme-text-muted leading-relaxed m-0">
                      {row.body}
                    </p>
                  )}
                  {row.bullets && row.bullets.length > 0 && (
                    <ul class="flex flex-col gap-2.5 m-0 p-0 list-none">
                      {row.bullets.map((bullet) => (
                        <li class="flex items-start gap-2.5">
                          <svg
                            class="check-icon"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M20 6L9 17l-5-5" />
                          </svg>
                          <span class="theme-text text-sm leading-relaxed">
                            {bullet}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                {/* Image */}
                <div
                  class={`feature-image ${imageRight ? "lg:order-2" : "lg:order-1"}`}
                >
                  {row.image && (
                    <SmartImage
                      src={row.image.src}
                      alt={row.image.alt ?? ""}
                      widths={[480, 768, 1024]}
                      sizes="(min-width: 1024px) 50vw, 100vw"
                      class="w-full h-full object-cover"
                    />
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )
}

<style>
  .feature-image {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    aspect-ratio: 4/3;
    box-shadow: var(--t-shadow-md);
  }

  .feature-image :global(img) {
    border-radius: 1rem;
  }

  .check-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    margin-top: 0.125rem;
    stroke: var(--theme-accent);
  }
</style>
