---
import { getBusinessData } from "@/lib/utils";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";
import { Button } from "@/components/elements/button";

/**
 * location:service-area — a coverage-focused layout for mobile / on-site trades.
 * A checklist of covered cities/neighborhoods sits beside an area map, with a
 * "not sure if we cover you? call" CTA. Structurally distinct: it emphasises the
 * service radius rather than a single storefront pin.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    mapEmbedUrl?: string;
    areas?: string[];
    footnote?: string;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();

const fullAddress = [
  business.address,
  [business.city, business.state].filter(Boolean).join(", "),
  business.zip,
]
  .filter(Boolean)
  .join(" ");

const telHref = business.phone ? `tel:${business.phone.replace(/[^\d+]/g, "")}` : null;
const areas = data?.areas ?? [];
const mapEmbedUrl =
  data?.mapEmbedUrl ??
  `https://www.google.com/maps?q=${encodeURIComponent(
    [business.city, business.state].filter(Boolean).join(", ") || fullAddress
  )}&z=11&output=embed`;
---

<section class:list={["location-service-area section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      {/* Coverage list */}
      <div>
        {
          data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs mb-4">{data.eyebrow.text}</Badge>
            ) : (
              <span class="block text-sm font-semibold uppercase tracking-widest theme-accent mb-4">
                {data.eyebrow.text}
              </span>
            ))
        }
        {
          data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>
          )
        }
        {data?.subheading && <p class="theme-text-muted text-lg m-0 mt-3">{data.subheading}</p>}

        {
          areas.length > 0 && (
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-lg gap-y-sm mt-8 p-0 list-none">
              {areas.map((area) => (
                <li class="flex items-center gap-2.5">
                  <span class="check-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                  <span class="theme-text font-medium">{area}</span>
                </li>
              ))}
            </ul>
          )
        }

        {data?.footnote && <p class="theme-text-subtle text-sm m-0 mt-6">{data.footnote}</p>}

        <div class="flex flex-col sm:flex-row gap-sm mt-8">
          {
            data?.cta && (
              <Button variant={data.cta.variant ?? "primary"} href={data.cta.href} class="w-full sm:w-auto">
                {data.cta.label}
              </Button>
            )
          }
          {
            telHref && (
              <Button variant="outline" href={telHref} class="w-full sm:w-auto">
                Call {business.phone}
              </Button>
            )
          }
        </div>
      </div>

      {/* Area map */}
      <div class="area-map overflow-hidden">
        <iframe
          src={mapEmbedUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Service area around ${business.city}, ${business.state}`}
          class="w-full h-full min-h-[340px] lg:min-h-[440px] border-0 block"></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .area-map {
    border-radius: var(--t-radius);
    border: var(--t-border-width) solid var(--theme-border);
    box-shadow: var(--t-shadow-md);
  }
  .check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--theme-accent) 14%, transparent);
    color: var(--theme-accent);
  }
  .check-icon svg {
    width: 0.9rem;
    height: 0.9rem;
  }
</style>
