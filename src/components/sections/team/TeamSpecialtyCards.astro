---
import type { Eyebrow, TeamMember } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import SmartImage from "@/components/media/SmartImage.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    members?: Array<TeamMember & { specialty?: string }>;
  };
}

const { theme = "default", data } = Astro.props;
const members = data?.members ?? [];

/** Derive up to two initials from a member's name. */
function initials(name: string): string {
  return name
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part.charAt(0).toUpperCase())
    .join("");
}
---

{
  members.length > 0 && (
    <section
      class:list={[
        "team-specialty-cards section-wrapper section-py",
        `theme-${theme}`,
      ]}
    >
      <div class="section-container">
        {/* Section header */}
        <div class="flex flex-col items-center text-center gap-3 mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="theme-accent text-sm font-semibold uppercase tracking-widest">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>

        {/* Specialty cards */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {members.map((member) => (
            <div class="specialty-card flex items-start gap-4 p-5">
              {member.photo ? (
                <SmartImage
                  src={member.photo}
                  alt={member.name}
                  widths={[128, 256]}
                  class="specialty-photo w-16 h-16 object-cover shrink-0"
                />
              ) : (
                <div class="specialty-avatar shrink-0" aria-hidden="true">
                  <span>{initials(member.name)}</span>
                </div>
              )}
              <div class="flex flex-col gap-1 min-w-0">
                <h3 class="theme-heading font-semibold m-0 leading-tight">
                  {member.name}
                </h3>
                {member.role && (
                  <p class="theme-text-subtle text-sm m-0">{member.role}</p>
                )}
                {member.specialty && (
                  <span class="specialty-tag mt-2">{member.specialty}</span>
                )}
                {member.bio && (
                  <p class="theme-text-muted text-sm leading-relaxed m-0 mt-2">
                    {member.bio}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .specialty-card {
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    box-shadow: var(--t-shadow-sm);
    transition: box-shadow 0.15s ease;
  }

  .specialty-card:hover {
    box-shadow: var(--t-shadow-md);
  }

  .specialty-photo {
    border-radius: 999px;
    box-shadow: var(--t-shadow-sm);
  }

  .specialty-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--theme-accent) 12%, transparent);
    color: var(--theme-accent);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .specialty-tag {
    align-self: flex-start;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: color-mix(in srgb, var(--theme-accent) 12%, transparent);
    color: var(--theme-accent);
  }
</style>
