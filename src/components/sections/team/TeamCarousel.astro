---
import type { Eyebrow, TeamMember } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import SmartImage from "@/components/media/SmartImage.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    members?: TeamMember[];
  };
}

const { theme = "default", data } = Astro.props;

const members = data?.members ?? [];

// Unique id so multiple instances on one page stay independent
const carouselId = `team-carousel-${Math.random().toString(36).slice(2, 9)}`;

/** Derive up to two initials from a member's name. */
function initials(name: string): string {
  return name
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part.charAt(0).toUpperCase())
    .join("");
}
---

{
  members.length > 0 && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-3 mb-12">
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                  {data.eyebrow.text}
                </span>
              ))}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg max-w-2xl m-0">
                {data.subheading}
              </p>
            )}
          </div>
        )}

        {/* Carousel */}
        <div class="team-carousel" data-team-carousel id={carouselId}>
          {/* Track */}
          <div class="team-carousel-track" data-team-carousel-track>
            {members.map((member) => (
              <article class="team-carousel-card rounded-2xl border theme-border bg-background">
                {member.photo ? (
                  <SmartImage
                    src={member.photo}
                    alt={member.name}
                    widths={[240, 480]}
                    class="team-member-photo w-full aspect-square object-cover rounded-xl"
                  />
                ) : (
                  <div class="team-member-avatar" aria-hidden="true">
                    <span>{initials(member.name)}</span>
                  </div>
                )}
                <div class="flex flex-col gap-1 mt-4">
                  <h3 class="theme-heading font-semibold m-0">{member.name}</h3>
                  {member.role && (
                    <p class="text-primary text-sm font-medium m-0">
                      {member.role}
                    </p>
                  )}
                  {member.bio && (
                    <p class="theme-text-muted text-sm leading-relaxed m-0 mt-1">
                      {member.bio}
                    </p>
                  )}
                </div>
              </article>
            ))}
          </div>

          {/* Controls */}
          <div class="team-carousel-controls">
            <button
              type="button"
              class="team-carousel-arrow border theme-border bg-background hover:bg-muted"
              data-team-carousel-prev
              aria-label="Previous team member"
            >
              <svg
                class="w-5 h-5"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </button>
            <button
              type="button"
              class="team-carousel-arrow border theme-border bg-background hover:bg-muted"
              data-team-carousel-next
              aria-label="Next team member"
            >
              <svg
                class="w-5 h-5"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  function initTeamCarousels() {
    const carousels = document.querySelectorAll<HTMLElement>(
      "[data-team-carousel]"
    );

    carousels.forEach((root) => {
      if (root.dataset.teamCarouselReady === "true") return;
      root.dataset.teamCarouselReady = "true";

      const track = root.querySelector<HTMLElement>(
        "[data-team-carousel-track]"
      );
      const prev = root.querySelector<HTMLElement>("[data-team-carousel-prev]");
      const next = root.querySelector<HTMLElement>("[data-team-carousel-next]");
      if (!track) return;

      const scrollByCard = (dir: number) => {
        const card = track.querySelector<HTMLElement>(".team-carousel-card");
        const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0;
        const amount = card ? card.offsetWidth + gap : track.clientWidth * 0.85;
        track.scrollBy({ left: amount * dir, behavior: "smooth" });
      };

      prev?.addEventListener("click", () => scrollByCard(-1));
      next?.addEventListener("click", () => scrollByCard(1));

      const updateArrows = () => {
        const maxScroll = track.scrollWidth - track.clientWidth - 1;
        if (prev) (prev as HTMLButtonElement).disabled = track.scrollLeft <= 0;
        if (next)
          (next as HTMLButtonElement).disabled = track.scrollLeft >= maxScroll;
      };

      track.addEventListener("scroll", updateArrows, { passive: true });
      window.addEventListener("resize", updateArrows);
      updateArrows();
    });
  }

  initTeamCarousels();
  document.addEventListener("astro:page-load", initTeamCarousels);
</script>

<style>
  .team-carousel {
    position: relative;
  }

  .team-carousel-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 0.25rem;
    /* Hide scrollbar — Firefox */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  /* Hide scrollbar — WebKit */
  .team-carousel-track::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .team-carousel-card {
    scroll-snap-align: start;
    flex: 0 0 auto;
    min-width: 70%;
    padding: 1.5rem;
    box-shadow: var(--t-shadow-md);
  }

  @media (min-width: 640px) {
    .team-carousel-card {
      min-width: 40%;
    }
  }

  @media (min-width: 1024px) {
    .team-carousel-card {
      min-width: 24%;
    }
  }

  .team-member-photo {
    box-shadow: var(--t-shadow-md);
  }

  .team-member-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--theme-accent) 12%, transparent);
    color: var(--theme-accent);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .team-carousel-controls {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .team-carousel-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-fg);
    cursor: pointer;
    transition:
      background 0.2s ease,
      opacity 0.2s ease;
  }

  .team-carousel-arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }
</style>
