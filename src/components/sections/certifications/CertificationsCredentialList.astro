---
import type { Eyebrow, CertItem } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import SmartImage from "@/components/media/SmartImage.astro";

/**
 * certifications:credential-list — a vertical list of license / insurance /
 * bonding credentials. Each row is a horizontal band: logo/shield on the left,
 * credential name + description in the middle, and an optional "Verify" link on
 * the right. `verifyUrl` on an item turns its row into a verifiable credential.
 * Built for the "licensed, bonded & insured" proof block.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    verifyLabel?: string;
    items?: (CertItem & { verifyUrl?: string; credentialId?: string })[];
  };
}

const { theme = "default", data } = Astro.props;
const items = data?.items ?? [];
const verifyLabel = data?.verifyLabel ?? "Verify";
---

<section class:list={["certifications-credential-list section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    {
      (data?.eyebrow || data?.heading || data?.subheading) && (
        <div class="flex flex-col gap-3 mb-10 max-w-2xl">
          {data?.eyebrow && (
            <div>
              {data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                  {data.eyebrow.text}
                </span>
              )}
            </div>
          )}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg m-0">{data.subheading}</p>
          )}
        </div>
      )
    }

    {
      items.length > 0 && (
        <ul class="flex flex-col gap-4 list-none m-0 p-0">
          {items.map((item) => (
            <li class="credential-row flex flex-col sm:flex-row sm:items-center gap-4 p-5">
              <span class="credential-icon">
                {item.logo ? (
                  <SmartImage
                    src={item.logo}
                    alt={item.label}
                    width={64}
                    class="h-9 w-auto object-contain"
                  />
                ) : (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                )}
              </span>

              <div class="flex flex-col gap-1 flex-1 min-w-0">
                <span class="theme-heading text-base font-semibold leading-tight">{item.label}</span>
                {item.description && (
                  <span class="theme-text-muted text-sm leading-snug">{item.description}</span>
                )}
                {item.credentialId && (
                  <span class="theme-text-subtle text-xs font-mono">#{item.credentialId}</span>
                )}
              </div>

              {item.verifyUrl && (
                <a
                  href={item.verifyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="verify-link inline-flex items-center gap-1.5 text-sm font-semibold shrink-0"
                >
                  {verifyLabel}
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                </a>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .credential-row {
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    box-shadow: var(--t-shadow-sm);
  }
  .credential-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--theme-accent, currentColor) 12%, transparent);
    color: var(--theme-accent, currentColor);
  }
  .credential-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }
  .verify-link {
    color: var(--theme-accent, currentColor);
  }
  .verify-link:hover {
    text-decoration: underline;
  }
</style>
