---
import { getCollection } from "astro:content";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    filter?: string;
    limit?: number;
  };
}

const { theme = "default", data } = Astro.props;

const allReviews = await getCollection("reviews");

const reviews = allReviews
  .filter((r) => (data?.filter === "featured" ? r.data.featured : true))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const count = reviews.length;
const average =
  count > 0
    ? reviews.reduce((sum, r) => sum + r.data.rating, 0) / count
    : 0;
const averageRounded = Math.round(average);

// Recent snippets shown beside the aggregate
const snippets = reviews.slice(0, data?.limit ?? 3);
---

{
  count > 0 && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-3 mb-12">
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                  {data.eyebrow.text}
                </span>
              ))}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg max-w-2xl m-0">
                {data.subheading}
              </p>
            )}
          </div>
        )}

        <div class="summary-grid">
          {/* Aggregate */}
          <div class="aggregate rounded-xl border theme-border bg-background">
            <span class="average-number theme-heading">
              {average.toFixed(1)}
            </span>
            <div class="flex items-center justify-center gap-1 my-3">
              {Array.from(
                { length: 5 },
                (_, i) => i < averageRounded
              ).map((filled) => (
                <svg
                  class={`w-6 h-6 ${filled ? "star-filled" : "star-empty"}`}
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
              ))}
            </div>
            <span class="theme-text-muted text-sm">
              based on {count} {count === 1 ? "review" : "reviews"}
            </span>
          </div>

          {/* Recent snippets */}
          <div class="snippet-grid">
            {snippets.map((review) => (
              <div class="snippet rounded-xl border theme-border bg-background">
                <div class="flex items-center gap-0.5 mb-2">
                  {Array.from(
                    { length: 5 },
                    (_, i) => i < review.data.rating
                  ).map((filled) => (
                    <svg
                      class={`w-3.5 h-3.5 ${filled ? "star-filled" : "star-empty"}`}
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                  ))}
                </div>
                <p class="snippet-body theme-text">{review.data.body}</p>
                <div class="flex items-center gap-2 mt-3">
                  <span class="theme-heading font-semibold text-sm">
                    {review.data.author}
                  </span>
                  {review.data.location && (
                    <span class="theme-text-subtle text-xs">
                      {review.data.location}
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .summary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .summary-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.75fr);
    }
  }

  /* Aggregate block */
  .aggregate {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2.5rem 1.5rem;
  }

  .average-number {
    font-size: 4rem;
    line-height: 1;
    font-weight: 800;
  }

  /* Snippets */
  .snippet-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .snippet-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .snippet {
    padding: 1.25rem;
  }

  .snippet-body {
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Stars */
  .star-filled {
    color: var(--color-rating);
  }

  .star-empty {
    color: var(--color-rating-empty);
  }
</style>
