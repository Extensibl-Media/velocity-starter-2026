---
import { getReviews } from "@/lib/content";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
    filter?: "featured" | "all";
    service?: string;
  };
}

const { theme = "default", data } = Astro.props;

const allReviews = await getReviews();

const reviews = allReviews
  .filter((r) => (data?.filter === "all" ? true : r.data.featured))
  .filter((r) => !data?.service || r.data.service === data.service)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, data?.limit ?? 8);
---

<section class:list={["reviews-wall section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    {
      (data?.eyebrow || data?.heading || data?.subheading) && (
        <div class="flex flex-col items-center text-center gap-sm mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>
      )
    }

    {
      reviews.length > 0 ? (
        <div class="wall-frame">
          <div class="wall-grid">
            {reviews.map((review) => (
              <article class="wall-item">
                <div class="flex items-center justify-between gap-sm mb-3">
                  <div class="flex items-center gap-0.5">
                    {Array.from(
                      { length: 5 },
                      (_, i) => review.data.rating > i
                    ).map((filled) => (
                      <svg
                        class={`w-4 h-4 ${filled ? "star-filled" : "star-empty"}`}
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                      </svg>
                    ))}
                  </div>
                  <span class="theme-text-subtle text-xs shrink-0">
                    {review.data.date.toLocaleDateString("en-US", {
                      month: "short",
                      year: "numeric",
                    })}
                  </span>
                </div>

                <p class="wall-body theme-text">{review.data.body}</p>

                <div class="flex items-baseline gap-xs mt-4">
                  <span class="theme-heading font-semibold text-sm leading-tight">
                    {review.data.author}
                  </span>
                  {review.data.location && (
                    <span class="theme-text-subtle text-xs">
                      &middot; {review.data.location}
                    </span>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      ) : (
        <p class="text-center theme-text-muted">No reviews yet.</p>
      )
    }
  </div>
</section>

<style>
  .wall-frame {
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    overflow: hidden;
  }

  .wall-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .wall-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .wall-item {
    padding: 1.75rem;
    border-top: var(--t-border-width) solid var(--theme-border);
    border-left: var(--t-border-width) solid var(--theme-border);
  }

  /* Remove top border on the first row */
  .wall-item:nth-child(1),
  .wall-item:nth-child(2) {
    border-top: 0;
  }

  /* Remove left border on the leading column so only inner rules show */
  .wall-item:nth-child(odd) {
    border-left: 0;
  }

  @media (max-width: 767px) {
    .wall-item {
      border-left: 0;
    }
    .wall-item:nth-child(1) {
      border-top: 0;
    }
    .wall-item:nth-child(2) {
      border-top: var(--t-border-width) solid var(--theme-border);
    }
  }

  .wall-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    margin: 0;
  }

  .star-filled {
    color: var(--color-rating);
  }

  .star-empty {
    color: var(--color-rating-empty);
  }
</style>
