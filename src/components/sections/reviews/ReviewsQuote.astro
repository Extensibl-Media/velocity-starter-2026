---
import { getReviews } from "@/lib/content";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    filter?: string;
    limit?: number;
  };
}

const { theme = "default", data } = Astro.props;

const allReviews = await getReviews();

const reviews = allReviews
  .filter((r) => (data?.filter === "featured" ? r.data.featured : true))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Ignores limit — shows exactly one pull-quote
const review = reviews[0];
---

{
  review && (
    <section class={`section-wrapper section-py theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-sm mb-12">
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                  {data.eyebrow.text}
                </span>
              ))}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg max-w-2xl m-0">
                {data.subheading}
              </p>
            )}
          </div>
        )}

        {/* Oversized pull-quote */}
        <figure class="pull-quote max-w-4xl mx-auto text-center">
          <span class="quote-mark" aria-hidden="true">
            &ldquo;
          </span>

          {/* Stars */}
          <div class="flex items-center justify-center gap-1 mb-6">
            {Array.from({ length: 5 }, (_, i) => i < review.data.rating).map(
              (filled) => (
                <svg
                  class={`w-6 h-6 ${filled ? "star-filled" : "star-empty"}`}
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                </svg>
              )
            )}
          </div>

          <blockquote class="quote-body theme-heading">
            {review.data.body}
          </blockquote>

          <figcaption class="mt-8">
            <span class="theme-heading font-semibold text-lg block">
              {review.data.author}
            </span>
            {review.data.location && (
              <span class="theme-text-muted text-base">
                {review.data.location}
              </span>
            )}
          </figcaption>
        </figure>
      </div>
    </section>
  )
}

<style>
  .pull-quote {
    position: relative;
  }

  .quote-mark {
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 8rem;
    line-height: 0.6;
    height: 3.5rem;
    color: var(--theme-accent);
    opacity: 0.18;
    margin-bottom: 0.5rem;
    user-select: none;
  }

  /* Stars */
  .star-filled {
    color: var(--color-rating);
  }

  .star-empty {
    color: var(--color-rating-empty);
  }

  .quote-body {
    font-size: 1.75rem;
    line-height: 1.5;
    font-style: italic;
    font-weight: 500;
    margin: 0;
    text-wrap: balance;
  }

  @media (min-width: 1024px) {
    .quote-body {
      font-size: 2.25rem;
    }
  }
</style>
