---
import { getCollection } from "astro:content";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
    filter?: "featured" | "all";
    service?: string;
  };
}

const { theme = "default", data } = Astro.props;

const allReviews = await getCollection("reviews");

const reviews = allReviews
  .filter((r) => (data?.filter === "all" ? true : r.data.featured))
  .filter((r) => !data?.service || r.data.service === data.service)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, data?.limit ?? 4);
---

<section class:list={["reviews-band section-wrapper section-py", `theme-${theme}`]}>
  <div class="section-container">
    {
      (data?.eyebrow || data?.heading || data?.subheading) && (
        <div class="flex flex-col items-center text-center gap-3 mb-10">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>
      )
    }

    {
      reviews.length > 0 ? (
        <div class="band">
          {reviews.map((review) => (
            <div class="band-item">
              <div class="flex items-center justify-center gap-0.5 mb-2.5">
                {Array.from(
                  { length: 5 },
                  (_, i) => review.data.rating > i
                ).map((filled) => (
                  <svg
                    class={`w-4 h-4 ${filled ? "star-filled" : "star-empty"}`}
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                ))}
              </div>

              <p class="band-body theme-text">{review.data.body}</p>

              <div class="band-author">
                <span class="theme-heading font-semibold text-sm">
                  {review.data.author}
                </span>
                {review.data.location && (
                  <span class="theme-text-subtle text-xs">
                    {review.data.location}
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-center theme-text-muted">No reviews yet.</p>
      )
    }
  </div>
</section>

<style>
  .band {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2rem 0;
    border-top: var(--t-border-width) solid var(--theme-border);
    border-bottom: var(--t-border-width) solid var(--theme-border);
  }

  @media (min-width: 768px) {
    .band {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: 0;
    }
  }

  .band-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 1.5rem;
  }

  /* Vertical divider between items on wider screens */
  @media (min-width: 768px) {
    .band-item + .band-item {
      border-left: var(--t-border-width) solid var(--theme-border);
    }
  }

  .band-body {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0 0 0.875rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .band-author {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-top: auto;
  }

  .star-filled {
    color: var(--color-rating);
  }

  .star-empty {
    color: var(--color-rating-empty);
  }
</style>
