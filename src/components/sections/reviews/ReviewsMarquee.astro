---
import { getReviews } from "@/lib/content";
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    limit?: number;
    filter?: "featured" | "all";
    service?: string;
  };
}

const { theme = "default", data } = Astro.props;

const allReviews = await getReviews();

const reviews = allReviews
  .filter((r) => (data?.filter === "all" ? true : r.data.featured))
  .filter((r) => !data?.service || r.data.service === data.service)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, data?.limit ?? 8);

// Duplicate the track so the CSS marquee can loop seamlessly.
const track = [...reviews, ...reviews];

function getInitials(name: string) {
  return name
    .split(" ")
    .map((n) => n[0])
    .join("")
    .toUpperCase()
    .slice(0, 2);
}
---

<section
  class:list={["reviews-marquee section-wrapper section-py", `theme-${theme}`]}
>
  <div class="section-container">
    {
      (data?.eyebrow || data?.heading || data?.subheading) && (
        <div class="flex flex-col items-center text-center gap-sm mb-12">
          {data?.eyebrow &&
            (data.eyebrow.variant === "badge" ? (
              <Badge class="uppercase tracking-widest text-xs">
                {data.eyebrow.text}
              </Badge>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                {data.eyebrow.text}
              </span>
            ))}
          {data?.heading && (
            <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
              {data.heading}
            </h2>
          )}
          {data?.subheading && (
            <p class="theme-text-muted text-lg max-w-2xl m-0">
              {data.subheading}
            </p>
          )}
        </div>
      )
    }
  </div>

  {
    reviews.length > 0 ? (
      <div class="marquee" aria-label="Customer reviews">
        <div class="marquee-track">
          {track.map((review, idx) => (
            <article class="marquee-card" aria-hidden={idx >= reviews.length}>
              <div class="flex items-center gap-0.5 mb-3">
                {Array.from(
                  { length: 5 },
                  (_, i) => review.data.rating > i
                ).map((filled) => (
                  <svg
                    class={`w-4 h-4 ${filled ? "star-filled" : "star-empty"}`}
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                ))}
              </div>

              <p class="marquee-body theme-text">{review.data.body}</p>

              <div class="flex items-center gap-2.5 mt-4">
                <div class="avatar" aria-hidden="true">
                  {getInitials(review.data.author)}
                </div>
                <div class="flex flex-col">
                  <span class="theme-heading font-semibold text-sm leading-tight">
                    {review.data.author}
                  </span>
                  {review.data.location && (
                    <span class="theme-text-subtle text-xs">
                      {review.data.location}
                    </span>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    ) : (
      <div class="section-container">
        <p class="text-center theme-text-muted">No reviews yet.</p>
      </div>
    )
  }
</section>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
  }

  .marquee-track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    animation: marquee-scroll 48s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* Track is doubled, so shifting by half returns to the start seamlessly. */
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }
  }

  .marquee-card {
    flex: 0 0 auto;
    width: 20rem;
    padding: 1.5rem;
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    box-shadow: var(--t-shadow-sm);
  }

  .avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--theme-accent) 16%, transparent);
    color: var(--theme-accent);
  }

  .marquee-body {
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .star-filled {
    color: var(--color-rating);
  }

  .star-empty {
    color: var(--color-rating-empty);
  }
</style>
