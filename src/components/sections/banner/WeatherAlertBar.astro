---
import type { SectionCTA } from "@/types/sections";

interface Props {
  theme?: string;
  data?: {
    label?: string;
    text?: string;
    cta?: SectionCTA;
    dismissible?: boolean;
  };
}

const { theme = "brand-secondary", data } = Astro.props;
const hasContent = !!(data?.text || data?.cta);
const label = data?.label ?? "Storm Alert";
---

{
  hasContent && (
    <section
      data-weather-alert
      class:list={["banner-weather-alert", `theme-${theme}`]}
    >
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3 text-sm">
        <svg
          class="h-5 w-5 shrink-0 theme-accent"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
          <path d="M12 9v4M12 17h.01" />
        </svg>
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <span class="theme-heading font-bold uppercase tracking-wide">
            {label}
          </span>
          {data?.text && (
            <span class="theme-text">{data.text}</span>
          )}
        </div>
        {data?.cta && (
          <a
            href={data.cta.href}
            class="theme-text ml-auto inline-flex shrink-0 items-center gap-1 font-bold underline underline-offset-2 transition-opacity hover:opacity-80"
          >
            {data.cta.label}
            <svg
              class="h-3.5 w-3.5 shrink-0"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        )}
        {data?.dismissible && (
          <button
            type="button"
            data-dismiss
            aria-label="Dismiss"
            class="theme-text inline-flex shrink-0 items-center justify-center rounded p-1 opacity-70 transition-opacity hover:opacity-100"
          >
            <svg
              class="h-4 w-4 shrink-0"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
          </button>
        )}
      </div>
    </section>
  )
}

<style>
  .banner-weather-alert {
    width: 100%;
    border-bottom: var(--t-border-width) solid var(--theme-border);
  }
</style>

<script>
  function initAlerts() {
    document
      .querySelectorAll<HTMLElement>("[data-weather-alert] [data-dismiss]")
      .forEach((b) => {
        if (b.dataset.ready) return;
        b.dataset.ready = "1";
        b.addEventListener("click", () => {
          const root = b.closest("[data-weather-alert]");
          if (root) (root as HTMLElement).hidden = true;
        });
      });
  }
  initAlerts();
  document.addEventListener("astro:page-load", initAlerts);
</script>
