---
import type { SectionCTA } from "@/types/sections";
import { Button } from "@/components/elements/button";

interface Props {
  theme?: string;
  data?: {
    headline?: string;
    subtext?: string;
    highlights?: string[];
    cta?: SectionCTA;
  };
}

const { theme = "inverse", data } = Astro.props;
const headline = data?.headline ?? "Financing available";
const highlights = data?.highlights ?? [];
---

<section class:list={["banner-financing", `theme-${theme}`]}>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-5 gap-y-1 px-4 py-3 text-sm sm:justify-between">
    <div class="flex items-center gap-sm text-center sm:text-left">
      <svg
        class="hidden h-6 w-6 shrink-0 theme-accent sm:block"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <rect x="2" y="5" width="20" height="14" rx="2" />
        <path d="M2 10h20" />
      </svg>
      <div class="flex flex-wrap items-baseline gap-x-xs">
        <span class="theme-heading font-bold">{headline}</span>
        {data?.subtext && (
          <span class="theme-text-muted">{data.subtext}</span>
        )}
      </div>
    </div>

    {highlights.length > 0 && (
      <ul class="hidden items-center gap-md md:flex">
        {highlights.map((h) => (
          <li class="theme-text inline-flex items-center gap-1.5 font-medium">
            <svg
              class="h-4 w-4 shrink-0 theme-accent"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5" />
            </svg>
            {h}
          </li>
        ))}
      </ul>
    )}

    {data?.cta && (
      <Button variant={data.cta.variant ?? "primary"} href={data.cta.href} size="sm">
        {data.cta.label}
      </Button>
    )}
  </div>
</section>

<style>
  .banner-financing {
    width: 100%;
    border-bottom: var(--t-border-width) solid var(--theme-border);
  }
</style>
