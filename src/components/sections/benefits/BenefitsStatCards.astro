---
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

/**
 * benefits:stat-cards — a trio (or row) of benefit cards where each pairs a big
 * accent stat with a short benefit statement, so the value is quantified. Best
 * for 2–4 items.
 */
interface StatBenefit {
  stat: string;
  title: string;
  body?: string;
  icon?: string;
}

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    items?: StatBenefit[];
  };
}

const { theme = "default", data } = Astro.props;
const items = data?.items ?? [];

const iconPaths: Record<string, string> = {
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>',
  star: '<path d="M12 3l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 18.8 6.2 21.9l1.1-6.5L2.6 9.8l6.5-.9L12 3z"/>',
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-6h6v6"/>',
  award: '<circle cx="12" cy="9" r="6"/><path d="M8.5 13.5 7 22l5-3 5 3-1.5-8.5"/>',
  wrench:
    '<path d="M14.5 6.5a4 4 0 0 0-5 5L3 18l3 3 6.5-6.5a4 4 0 0 0 5-5l-2.5 2.5-2-2 2.5-2.5z"/>',
  bolt: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>',
};

const gridClass =
  items.length === 2
    ? "sm:grid-cols-2"
    : items.length === 4
      ? "sm:grid-cols-2 lg:grid-cols-4"
      : "sm:grid-cols-2 lg:grid-cols-3";
---

{
  items.length > 0 && (
    <section
      class:list={[
        "benefits-stat-cards section-wrapper section-py",
        `theme-${theme}`,
      ]}
    >
      <div class="section-container">
        {/* Section header */}
        {(data?.eyebrow || data?.heading || data?.subheading) && (
          <div class="flex flex-col items-center text-center gap-sm mb-12">
            {data?.eyebrow &&
              (data.eyebrow.variant === "badge" ? (
                <Badge class="uppercase tracking-widest text-xs">
                  {data.eyebrow.text}
                </Badge>
              ) : (
                <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                  {data.eyebrow.text}
                </span>
              ))}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg max-w-2xl m-0">
                {data.subheading}
              </p>
            )}
          </div>
        )}

        <div class={`grid grid-cols-1 ${gridClass} gap-lg`}>
          {items.map((item) => (
            <div class="stat-card flex flex-col gap-sm p-7">
              <div class="flex items-center justify-between">
                <span class="stat-value theme-accent">{item.stat}</span>
                {item.icon && (
                  <span class="stat-icon" aria-hidden="true">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <Fragment
                        set:html={iconPaths[item.icon] ?? iconPaths.check}
                      />
                    </svg>
                  </span>
                )}
              </div>
              <h3 class="theme-heading text-lg font-semibold m-0">
                {item.title}
              </h3>
              {item.body && (
                <p class="theme-text-muted text-sm leading-relaxed m-0">
                  {item.body}
                </p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .stat-card {
    background-color: var(--card);
    border: var(--t-border-width) solid var(--theme-border);
    border-radius: var(--t-radius);
    box-shadow: var(--t-shadow-md);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .stat-card:hover {
    box-shadow: var(--t-shadow-lg);
    transform: translateY(-2px);
  }

  .stat-value {
    font-size: 2.5rem;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--theme-accent) 14%, transparent);
    color: var(--theme-accent);
  }

  .stat-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }
</style>
