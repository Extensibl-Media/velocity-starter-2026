---
import { getBusinessData } from "@/lib/utils";
import { getBackgroundImage } from "@/lib/images";
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import { Button } from "@/components/starwind/button";

/**
 * hero:video — full-bleed background video with a dark overlay and
 * heading/subheading/CTAs on top. Falls back to the poster image as a
 * static background when no videoSrc is provided.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    ctas?: SectionCTA[];
    showPhone?: boolean;
    videoSrc?: string;
    poster?: string;
    overlayOpacity?: number;
  };
}

const { theme = "default", data } = Astro.props;
const business = await getBusinessData();

const heading = data?.heading;
const subheading = data?.subheading;

const posterUrl = await getBackgroundImage(data?.poster, { width: 2200 });
const hasVideo = !!data?.videoSrc;
const hasPoster = !!posterUrl;
const overlayOpacity = (data?.overlayOpacity ?? 60) / 100;
---

<section
  class:list={[
    "hero-video section-wrapper relative overflow-hidden flex items-center min-h-[600px]",
    `theme-${theme}`,
    hasPoster && !hasVideo ? "has-bg" : "",
  ]}
  style={`--hero-overlay: ${overlayOpacity}${hasPoster ? `; --hero-image: url('${posterUrl}')` : ""}`}
>
  {
    hasVideo && (
      <video
        class="hero-video-media"
        autoplay
        muted
        loop
        playsinline
        poster={posterUrl ?? undefined}
      >
        <source src={data?.videoSrc} />
      </video>
    )
  }
  <div class="section-container relative z-10 py-20 lg:py-28">
    <div class="flex flex-col gap-5 max-w-2xl">
      {
        data?.eyebrow && (
          data.eyebrow.variant === "badge" ? (
            <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
          ) : (
            <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
              {data.eyebrow.text}
            </span>
          )
        )
      }
      {heading && <h1 class="theme-heading text-4xl sm:text-5xl font-bold m-0 leading-tight">{heading}</h1>}
      {subheading && <p class="theme-text-muted text-lg lg:text-xl max-w-xl m-0">{subheading}</p>}
      {
        (data?.ctas?.length || data?.showPhone) && (
          <div class="flex flex-wrap items-center gap-3 mt-2">
            {data?.ctas?.map((cta) => (
              <Button variant={cta.variant ?? "primary"} href={cta.href}>{cta.label}</Button>
            ))}
            {data?.showPhone && business.phone && (
              <a href={`tel:${business.phone}`} class="inline-flex items-center gap-2 font-bold text-lg theme-text hover:opacity-80 transition-opacity no-underline">
                <svg class="w-5 h-5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                {business.phone}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero-video-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-video.has-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--hero-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .hero-video::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, var(--hero-overlay, 0.6));
  }
</style>
