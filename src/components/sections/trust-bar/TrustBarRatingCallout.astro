---
import type { SectionCTA } from "@/types/sections";
import { Button } from "@/components/elements/button";

interface Props {
  theme?: string;
  data?: {
    rating?: number;
    count?: number;
    sourceName?: string;
    label?: string;
    cta?: SectionCTA;
  };
}

const { theme = "default", data } = Astro.props;

const rating = data?.rating ?? null;
const count = data?.count ?? null;
const sourceName = data?.sourceName ?? "Google";
const label = data?.label ?? null;
const cta = data?.cta ?? null;

const fullStars = rating ? Math.floor(rating) : 0;
const hasHalf = rating ? rating % 1 >= 0.5 : false;
const emptyStars = rating ? 5 - fullStars - (hasHalf ? 1 : 0) : 0;

const starPath =
  "M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z";
---

{
  rating && (
    <section
      class:list={[
        "trust-bar-rating-callout section-wrapper section-py-sm",
        `theme-${theme}`,
      ]}
    >
      <div class="section-container">
        <div
          class="surface-base flex flex-col md:flex-row items-center justify-center gap-lg md:gap-10 p-6 md:p-8 mx-auto max-w-3xl"
          style="border: 1px solid var(--theme-border); border-radius: var(--t-radius);"
        >
          <div class="flex items-baseline gap-xs shrink-0">
            <span class="theme-heading text-5xl md:text-6xl font-bold leading-none">
              {rating.toFixed(1)}
            </span>
            <span class="theme-text-subtle text-lg font-medium">/ 5</span>
          </div>

          <span
            class="hidden md:block w-px self-stretch shrink-0"
            style="background-color: var(--theme-border);"
            aria-hidden="true"
          />

          <div class="flex flex-col items-center md:items-start gap-xs text-center md:text-left">
            <span
              class="flex items-center gap-1"
              aria-label={`${rating} out of 5 stars`}
            >
              {Array.from({ length: fullStars }).map(() => (
                <svg class="w-5 h-5" viewBox="0 0 20 20" fill="var(--color-rating)" aria-hidden="true">
                  <path d={starPath} />
                </svg>
              ))}
              {hasHalf && (
                <svg class="w-5 h-5" viewBox="0 0 20 20" aria-hidden="true">
                  <defs>
                    <linearGradient id="rating-callout-half">
                      <stop offset="50%" stop-color="var(--color-rating)" />
                      <stop offset="50%" stop-color="var(--color-rating-empty)" />
                    </linearGradient>
                  </defs>
                  <path fill="url(#rating-callout-half)" d={starPath} />
                </svg>
              )}
              {Array.from({ length: emptyStars }).map(() => (
                <svg class="w-5 h-5" viewBox="0 0 20 20" fill="var(--color-rating-empty)" aria-hidden="true">
                  <path d={starPath} />
                </svg>
              ))}
            </span>
            <p class="theme-text-muted text-sm m-0">
              {label ?? `Rated ${rating.toFixed(1)} on ${sourceName}`}
              {count && (
                <span class="theme-text-subtle">
                  {" "}from {count.toLocaleString()} reviews
                </span>
              )}
            </p>
          </div>

          {cta?.href && cta?.label && (
            <div class="shrink-0 md:ml-2">
              <Button href={cta.href} variant={cta.variant ?? "primary"}>
                {cta.label}
              </Button>
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
