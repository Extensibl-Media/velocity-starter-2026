---
import type { Eyebrow, RatingSource } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";

interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    sources?: RatingSource[];
  };
}

const { theme = "default", data } = Astro.props;

const sources = data?.sources ?? [];

/** Third-party brand colors — the allowed hardcode exception. */
const brandColors: Record<string, string> = {
  Google: "#4285F4",
  Facebook: "#1877F2",
  Yelp: "#D32323",
};
---

{
  sources.length > 0 && (
    <section class={`section-wrapper section-py-sm theme-${theme}`}>
      <div class="section-container">
        {/* Section header */}
        {(data?.eyebrow || data?.heading) && (
          <div class="flex flex-col items-center text-center gap-3 mb-8">
            {data?.eyebrow && (
              <div>
                {data.eyebrow.variant === "badge" ? (
                  <Badge class="uppercase tracking-widest text-xs">
                    {data.eyebrow.text}
                  </Badge>
                ) : (
                  <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                    {data.eyebrow.text}
                  </span>
                )}
              </div>
            )}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">
                {data.heading}
              </h2>
            )}
          </div>
        )}

        {/* Ratings row */}
        <ul class="flex flex-wrap items-center justify-center gap-y-6 gap-x-8 md:gap-x-12 list-none m-0 p-0">
          {sources.map((source) => {
            const filled = Math.round(source.rating);
            const empty = Math.max(0, 5 - filled);
            const brandColor = brandColors[source.name];

            const item = (
              <div class="flex items-center gap-3">
                <span
                  class:list={[
                    "text-sm font-bold leading-none",
                    !brandColor && "theme-text",
                  ]}
                  style={brandColor ? `color: ${brandColor}` : undefined}
                >
                  {source.name}
                </span>
                <span
                  class="flex items-center gap-0.5"
                  aria-label={`${source.rating} out of 5 stars`}
                >
                  {Array.from({ length: filled }).map(() => (
                    <svg
                      class="w-3.5 h-3.5"
                      viewBox="0 0 20 20"
                      fill="var(--color-rating)"
                      aria-hidden="true"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                  {Array.from({ length: empty }).map(() => (
                    <svg
                      class="w-3.5 h-3.5"
                      viewBox="0 0 20 20"
                      fill="var(--color-rating-empty)"
                      aria-hidden="true"
                    >
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </span>
                <span class="text-sm font-bold theme-text leading-none">
                  {source.rating.toFixed(1)}
                </span>
                {source.count != null && (
                  <span class="text-sm theme-text-muted leading-none">
                    ({source.count.toLocaleString()} reviews)
                  </span>
                )}
              </div>
            );

            return (
              <li class="flex items-center">
                {source.url ? (
                  <a href={source.url} class="no-underline">
                    {item}
                  </a>
                ) : (
                  item
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}
