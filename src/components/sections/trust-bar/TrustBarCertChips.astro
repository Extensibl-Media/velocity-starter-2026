---
import type { CertItem } from "@/types/sections";
import SmartImage from "@/components/media/SmartImage.astro";

interface Props {
  theme?: string;
  data?: {
    heading?: string;
    items?: CertItem[];
  };
}

const { theme = "default", data } = Astro.props;

const heading = data?.heading ?? null;
const items = data?.items ?? [];
---

{
  items.length > 0 && (
    <section
      class:list={[
        "trust-bar-cert-chips section-wrapper section-py-xs",
        `theme-${theme}`,
      ]}
    >
      <div class="section-container">
        {heading && (
          <p class="theme-text-subtle text-xs font-semibold uppercase tracking-widest text-center m-0 mb-5">
            {heading}
          </p>
        )}

        <ul class="flex flex-wrap items-center justify-center gap-2.5 md:gap-3 list-none m-0 p-0">
          {items.map((item) => (
            <li
              class="surface-base inline-flex items-center gap-2 px-3.5 py-2"
              style="border: 1px solid var(--theme-border); border-radius: 9999px;"
              title={item.description ?? undefined}
            >
              {item.logo ? (
                <SmartImage
                  src={item.logo}
                  alt={item.label ?? ""}
                  widths={[40, 80]}
                  class="h-5 w-5 object-contain shrink-0"
                />
              ) : (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  style="color: var(--theme-accent);"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  />
                </svg>
              )}
              <span class="theme-text text-sm font-semibold whitespace-nowrap">
                {item.label}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
