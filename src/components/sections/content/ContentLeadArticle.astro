---
import type { Eyebrow, SectionCTA } from "@/types/sections";
import Badge from "@/components/starwind/badge/Badge.astro";
import { Button } from "@/components/starwind/button";

/**
 * content:lead-article — a magazine-style article opening. An emphasized
 * standfirst/lead paragraph gets a decorative drop cap on its first letter,
 * then the long-form `body` (HTML string) flows beneath it in a narrow measure.
 * Distinct from content:rich-text by the drop-cap editorial intro. Theme-pure:
 * typography and the drop-cap accent derive from design tokens.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    lead?: string;
    body?: string;
    cta?: SectionCTA;
    secondaryCta?: SectionCTA;
    ctas?: SectionCTA[];
  };
}

const { theme = "default", data } = Astro.props;

const ctas = (
  data?.ctas?.length ? data.ctas : [data?.cta, data?.secondaryCta].filter(Boolean)
) as SectionCTA[];

const hasHeader = Boolean(data?.eyebrow || data?.heading || data?.subheading);
const hasBody = Boolean(data?.lead || data?.body);
---

{
  (hasHeader || hasBody) && (
    <section class:list={["content-lead-article section-wrapper section-py", `theme-${theme}`]}>
      <div class="section-container">
        <article class="max-w-2xl mx-auto">
          {hasHeader && (
            <header class="flex flex-col gap-3 mb-8">
              {data?.eyebrow &&
                (data.eyebrow.variant === "badge" ? (
                  <div>
                    <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
                  </div>
                ) : (
                  <span class="text-sm font-semibold uppercase tracking-widest theme-accent">
                    {data.eyebrow.text}
                  </span>
                ))}
              {data?.heading && (
                <h2 class="theme-heading text-3xl lg:text-5xl font-bold leading-tight m-0">
                  {data.heading}
                </h2>
              )}
              {data?.subheading && (
                <p class="theme-text-muted text-lg m-0">{data.subheading}</p>
              )}
            </header>
          )}

          {data?.lead && (
            <p class="lead-para theme-text m-0" set:html={data.lead} />
          )}

          {data?.body && <div class="rich-text theme-text mt-6" set:html={data.body} />}

          {ctas.length > 0 && (
            <div class="flex flex-wrap gap-4 mt-8">
              {ctas.map((cta, i) => (
                <Button href={cta.href} variant={cta.variant ?? (i === 0 ? "primary" : "outline")}>
                  {cta.label}
                </Button>
              ))}
            </div>
          )}
        </article>
      </div>
    </section>
  )
}

<style>
  .lead-para {
    font-size: 1.375rem;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .lead-para::first-letter {
    float: left;
    font-family: var(--font-heading);
    font-weight: var(--t-font-weight-heading);
    font-size: 3.75em;
    line-height: 0.82;
    padding: 0.05em 0.12em 0 0;
    color: var(--theme-accent);
  }

  .rich-text {
    line-height: 1.75;
  }
  .rich-text :global(> * + *) {
    margin-top: 1.25em;
  }
  .rich-text :global(h2),
  .rich-text :global(h3),
  .rich-text :global(h4) {
    color: var(--theme-heading);
    font-family: var(--font-heading);
    font-weight: var(--t-font-weight-heading);
    line-height: 1.25;
    margin-top: 2em;
  }
  .rich-text :global(h2) { font-size: 1.5rem; }
  .rich-text :global(h3) { font-size: 1.25rem; }
  .rich-text :global(a) {
    color: var(--theme-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .rich-text :global(ul),
  .rich-text :global(ol) {
    padding-left: 1.5rem;
  }
  .rich-text :global(ul) { list-style: disc; }
  .rich-text :global(ol) { list-style: decimal; }
  .rich-text :global(li + li) { margin-top: 0.5rem; }
  .rich-text :global(blockquote) {
    border-left: 3px solid var(--theme-accent);
    padding-left: 1rem;
    color: var(--theme-fg-muted);
    font-style: italic;
  }
  .rich-text :global(strong) { font-weight: 600; }
  .rich-text :global(img) { border-radius: var(--t-radius); }
</style>
