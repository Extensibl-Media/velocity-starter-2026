---
import type { Eyebrow } from "@/types/sections";
import Badge from "@/components/elements/badge/Badge.astro";

/**
 * content:rich-text — a prose block for long-form copy (legal pages, SEO
 * body content, service detail). `body` accepts an HTML string authored in
 * the CMS/JSON. Theme-pure: typography derives from design tokens.
 */
interface Props {
  theme?: string;
  data?: {
    eyebrow?: Eyebrow;
    heading?: string;
    subheading?: string;
    body?: string;
    align?: "left" | "center";
    width?: "prose" | "wide";
  };
}

const { theme = "default", data } = Astro.props;
const align = data?.align ?? "left";
const width = data?.width === "wide" ? "max-w-4xl" : "max-w-2xl";
---

<section class={`section-wrapper section-py theme-${theme}`}>
  <div class="section-container">
    <div class={`${width} ${align === "center" ? "mx-auto text-center" : "mx-auto"}`}>
      {
        (data?.eyebrow || data?.heading || data?.subheading) && (
          <div class={`flex flex-col gap-sm mb-8 ${align === "center" ? "items-center text-center" : ""}`}>
            {data?.eyebrow && (
              <div>
                {data.eyebrow.variant === "badge" ? (
                  <Badge class="uppercase tracking-widest text-xs">{data.eyebrow.text}</Badge>
                ) : (
                  <span class="text-sm font-semibold uppercase tracking-widest text-color-brand-secondary">
                    {data.eyebrow.text}
                  </span>
                )}
              </div>
            )}
            {data?.heading && (
              <h2 class="theme-heading text-3xl lg:text-4xl font-bold m-0">{data.heading}</h2>
            )}
            {data?.subheading && (
              <p class="theme-text-muted text-lg m-0">{data.subheading}</p>
            )}
          </div>
        )
      }

      {data?.body && <div class="rich-text theme-text" set:html={data.body} />}
    </div>
  </div>
</section>

<style>
  .rich-text {
    line-height: 1.75;
  }
  .rich-text :global(> * + *) {
    margin-top: 1.25em;
  }
  .rich-text :global(h2),
  .rich-text :global(h3),
  .rich-text :global(h4) {
    color: var(--theme-heading);
    font-family: var(--font-heading);
    font-weight: var(--t-font-weight-heading);
    line-height: 1.25;
    margin-top: 2em;
  }
  .rich-text :global(h2) { font-size: 1.5rem; }
  .rich-text :global(h3) { font-size: 1.25rem; }
  .rich-text :global(a) {
    color: var(--theme-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .rich-text :global(ul),
  .rich-text :global(ol) {
    padding-left: 1.5rem;
  }
  .rich-text :global(ul) { list-style: disc; }
  .rich-text :global(ol) { list-style: decimal; }
  .rich-text :global(li + li) { margin-top: 0.5rem; }
  .rich-text :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding-left: 1rem;
    color: var(--theme-fg-muted);
    font-style: italic;
  }
  .rich-text :global(strong) { font-weight: 600; }
  .rich-text :global(img) { border-radius: var(--radius); }
</style>
