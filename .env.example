# =============================================================================
# Velocity Web Studios Starter - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
SITE_URL=https://example.com

# -----------------------------------------------------------------------------
# Analytics (optional) — set one; the matching script auto-loads
# -----------------------------------------------------------------------------
# RECOMMENDED: Umami — cookieless & privacy-friendly, so NO consent banner needed.
# SRC is your (self-hosted or cloud) Umami instance's script URL.
# PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# PUBLIC_UMAMI_SRC=https://umami.example.com/script.js
#
# Plausible — also cookieless (no consent banner needed). Self-hostable via SRC.
# PUBLIC_PLAUSIBLE_DOMAIN=example.com
# PUBLIC_PLAUSIBLE_SRC=https://plausible.example.com/js/script.js

# -----------------------------------------------------------------------------
# Cookie-setting analytics & ad pixels (optional) — CONSENT-GATED
# -----------------------------------------------------------------------------
# ⚠ These SET COOKIES. Setting ANY of them makes the consent banner appear, and
#   the script only loads AFTER the visitor clicks "Accept" (GDPR/ePrivacy).
#   Prefer cookieless Umami/Plausible above unless a client insists on these.
#
# Google Analytics 4 / Google Tag Manager
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# PUBLIC_GTM_ID=GTM-XXXXXXX
#
# Ad pixels
# PUBLIC_META_PIXEL_ID=000000000000000
# PUBLIC_GOOGLE_ADS_ID=AW-000000000
# PUBLIC_TIKTOK_PIXEL_ID=XXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# Forms / CRM (optional) — where contact, newsletter, and quiz forms submit
# -----------------------------------------------------------------------------
# Adapter: stub (default, no network — dispatches a form:submit event) | webhook | netlify
# PUBLIC_FORM_ADAPTER=webhook
# Endpoint the webhook adapter POSTs JSON to (GHL inbound webhook, Zapier, Make, your API…)
# PUBLIC_FORM_ENDPOINT=https://services.leadconnectorhq.com/hooks/xx/webhook-trigger/xxx

# -----------------------------------------------------------------------------
# Search Engine Verification (optional)
# -----------------------------------------------------------------------------
# GOOGLE_SITE_VERIFICATION=your-verification-code
# BING_SITE_VERIFICATION=your-verification-code

# -----------------------------------------------------------------------------
# Maps (optional)
# -----------------------------------------------------------------------------
# PUBLIC_GOOGLE_MAPS_API_KEY=your-api-key

# -----------------------------------------------------------------------------
# GoHighLevel (optional)
# -----------------------------------------------------------------------------
# PUBLIC_GHL_CHAT_WIDGET_ID=your-widget-id
# PUBLIC_GHL_LOCATION_ID=your-location-id